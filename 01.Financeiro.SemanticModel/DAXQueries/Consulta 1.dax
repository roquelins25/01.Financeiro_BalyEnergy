    // fx Tabela Dinamica para contas fixas
        FUNCTION fxADMFixaValor =
        ( xID: STRING ) =>
                SWITCH(
                    TRUE(),
                    xID = "adto_motorista", CALCULATE( [10. Adiantamento Motorista] ),
                    xID = "ir", CALCULATE( [10. IR] ),
                    xID = "Tarifas" , CALCULATE( [10. Tarifa] ),
                    xID = "adtFor",CALCULATE( [10. Adiantamento Fornecedores] ),
                    xID = "cambiopassivo", CALCULATE( [10. Cambio Passivo] ),
                    xID = "despesasFinimp", CALCULATE( [10. Despesas de Finimp] ),
                    xID = "dJuros", CALCULATE( [10. Juros] ),
                    xID = "dCheques", CALCULATE( [10. CHEQUE] ) ,
                    xID = "dVarCambial", CALCULATE( [10. Varicao Cambial] ),
                    xID = "caixa_fruts_entrada",  CALCULATE( [10. Entrada FRUTS] ),
                    xID = "caixa_fruts_saida",    CALCULATE( [10. SAidas FRUTS] ),
                    BLANK()
                )




                