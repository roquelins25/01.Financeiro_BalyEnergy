	partition xCalendarioTable = calculated
		mode: import
		source = ```
				
				VAR _TotalGeral = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 1 ,
				    "Periodo", "Vlr Limite",
				    "Cod. Periodo", 1 )
				
				VAR _TotalPercent = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 2 ,
				    "Periodo", "PrazoMedio",
				    "Cod. Periodo", 2 )
				
				VAR _TotalAcum = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 3 ,
				    "Periodo", "Limite Suger.",
				    "Cod. Periodo", 3 )
				
				VAR _TotalMedio = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 4 ,
				    "Periodo", "Media Fat.",
				    "Cod. Periodo", 4 )
				
				VAR _Total = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 5 ,
				    "Periodo", "Total Fat.",
				    "Cod. Periodo", 5 )
				
				VAR _MES = 
				ADDCOLUMNS(
				    DISTINCT(
				    SELECTCOLUMNS(
				        'CALENDARIO DAX',
				        'CALENDARIO DAX'[Ano-Mes],
				        'CALENDARIO DAX'[Mês Abrev],
				        'CALENDARIO DAX'[AnoMesOrdem] ) ),
				    "Periodo", 'CALENDARIO DAX'[Ano-Mes] ,
				    "Cod. Periodo", 6 )
				
				VAR _ANO =
				    VAR Anos =
				        DISTINCT(
				            SELECTCOLUMNS(
				                'CALENDARIO DAX',
				                "Ano", 'CALENDARIO DAX'[Ano]
				            )
				        )
				    RETURN
				        ADDCOLUMNS(
				            Anos,
				            "Mês Abrev", BLANK(),
				            "Mês",
				                99999990 +
				                RANKX(
				                    Anos,
				                    [Ano],
				                    ,
				                    DESC,
				                    DENSE
				                ),
				            "Periodo", [Ano],
				            "Cod. Periodo", 7
				        )
				RETURN
				UNION(_MES,_ANO,_TotalGeral,_TotalPercent,_TotalAcum,_TotalMedio,_Total )
				
				```

