	partition xCalendarioTable = calculated
		mode: import
		source = ```
				
				VAR _TotalGeral = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 1 ,
				    "Periodo", "Total Geral",
				    "Cod. Periodo", 1 )
				
				VAR _TotalPercent = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 2 ,
				    "Periodo", "% Total",
				    "Cod. Periodo", 2 )
				
				VAR _TotalAcum = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 3 ,
				    "Periodo", "% Acum.",
				    "Cod. Periodo", 3 )
				
				VAR _MES = 
				ADDCOLUMNS(
				    DISTINCT(
				    SELECTCOLUMNS(
				        'CALENDARIO DAX',
				        'CALENDARIO DAX'[Ano-Mes],
				        'CALENDARIO DAX'[Mês Abrev],
				        'CALENDARIO DAX'[AnoMesOrdem] ) ),
				    "Periodo", 'CALENDARIO DAX'[Ano-Mes] ,
				    "Cod. Periodo", 4 )
				
				VAR _ANO =
				    VAR Anos =
				        DISTINCT(
				            SELECTCOLUMNS(
				                'CALENDARIO DAX',
				                "Ano", 'CALENDARIO DAX'[Ano]
				            )
				        )
				    RETURN
				        ADDCOLUMNS(
				            Anos,
				            "Mês Abrev", BLANK(),
				            "Mês",
				                99999990 +
				                RANKX(
				                    Anos,
				                    [Ano],
				                    ,
				                    DESC,
				                    DENSE
				                ),
				            "Periodo", [Ano],
				            "Cod. Periodo", 5
				        )
				RETURN
				UNION(_MES,_ANO,_TotalGeral,_TotalPercent,_TotalAcum )
				
				```

	annotation PBI_Id = 2cbb8927136348aa9806b6ff860b352a

