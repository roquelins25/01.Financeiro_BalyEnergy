	partition TB_Fatos_CR = m
		mode: import
		queryGroup: _Fatos\CP_CR
		source = ```
				let
				  Origem = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				SELECT
				    TCR.CODEMP                                     AS EMPRESA,
				    TCR.CODFIL                                     AS FILIAL,
				    TCR.CODTNS                                     AS CODTNS,
				    TNS.DESTNS                                     AS DESTNS,
				    TCR.NUMTIT                                     AS TITULO,
				    TCR.CODTPT                                     AS TIPO,
				    TCR.SITTIT                                     AS SIT,
				    TCR.CODCLI                                     AS CODCLIENTE,
				    TCR.DATEMI                                     AS EMISSAO,
				    TCR.CODPOR                                     AS PORTADOR,
				    TCR.DATENT                                     AS DATAENTRADA,
				    TCR.VCTORI                                     AS VENCTORI,
				
				    CASE
				        WHEN MOD(TRUNC(TCR.VCTPRO) - DATE '2024-01-01', 7) = 5 THEN TCR.VCTPRO + 2  -- sábado
				        WHEN MOD(TRUNC(TCR.VCTPRO) - DATE '2024-01-01', 7) = 6 THEN TCR.VCTPRO + 1  -- domingo
				        ELSE TCR.VCTPRO
				    END                                             AS VENCIMENTO,
				
				    TCR.CODREP                                     AS CODREP,
				    TCR.OBSTCR                                     AS OBSERVACAO,
				    TCR.CODFPG                                     AS CODPAGAMENTO,
				    TCR.NUMNFV                                     AS NUMNOTA,
				    TCR.NUMPED                                     AS NUMPEDIDO,
				    TCR.VLRORI                                     AS VALORORI,
				    TCR.VLRABE                                     AS VALORABERTO,
				    TCR.CODCRT                                     AS CARTEIRA,
				
				    CASE
				        WHEN TCR.CODFRJ IS NULL THEN '00'
				        WHEN TCR.CODFRJ = '' THEN '00'
				        ELSE TCR.CODFRJ
				    END                                             AS FORREAJ
				
				FROM E301TCR TCR
				
				INNER JOIN E001TNS TNS
				    ON TNS.CODEMP = TCR.CODEMP
				   AND TNS.CODTNS = TCR.CODTNS
				
				WHERE TCR.CODCLI NOT IN (11143,21982,17661,5517,2394,17935)
				  AND TCR.DATEMI >= TO_DATE('2021-01-01','YYYY-MM-DD')
				   ", HierarchicalNavigation = true])
				in
				  Origem
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

