	partition TB_Fatos_CR = m
		mode: import
		queryGroup: _Fatos
		source =
				let
				  Origem = Sql.Database("159.112.182.77", "I260220090255_ERPP", [CommandTimeout=#duration(0, 2, 0, 0), Query="select #(lf)#(tab)tcr.codemp empresa,#(lf)#(tab)tcr.codfil filial,#(lf)#(tab)tcr.codtns codtns,#(lf)#(tab)tns.destns destns,#(lf)#(tab)tcr.numtit titulo,#(lf)#(tab)tcr.codtpt tipo,#(lf)#(tab)tcr.sittit sit,#(lf)#(tab)tcr.codcli codcliente,#(lf)#(tab)tcr.datemi emissao,#(lf)#(tab)tcr.codpor portador,#(lf)#(tab)tcr.datent DataEntrada,#(lf)#(tab)tcr.vctori VenctOri,#(lf)#(tab)tcr.vctpro vencimento,#(lf)#(tab)tcr.codrep codrep,#(lf)#(tab)tcr.obstcr observacao,#(lf)#(tab)tcr.codfpg codpagamento,#(lf)#(tab)tcr.numnfv numnota,#(lf)#(tab)tcr.numped numpedido,#(tab)#(lf)#(tab)tcr.vlrori valorOri,#(lf)#(tab)tcr.vlrabe valorAberto,#(lf)#(tab)tcr.codcrt carteira,#(lf)#(tab)CASE #(lf)#(tab)#(tab)WHEN codfrj is null THEN '00' #(lf)#(tab)#(tab)WHEN codfrj = '' THEN '00'#(lf)#(tab)#(tab)ELSE codfrj#(lf)#(tab)END as ForReaj#(lf)#(tab)#(lf)from sapiens_producao.E301TCR tcr#(lf)INNER JOIN e001tns tns ON tns.codemp = tcr.codemp #(lf)#(tab)#(tab)      AND tns.codtns = tcr.codtns#(lf)where tcr.codcli not in('11143','21982','17661','5517','2394','17935') and tcr.datemi >= '20210101'"])
				in
				  Origem

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

