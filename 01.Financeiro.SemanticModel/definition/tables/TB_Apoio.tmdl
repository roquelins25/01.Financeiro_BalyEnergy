	partition TB_Apoio = m
		mode: import
		queryGroup: _Dim
		source =
				let
				  Origem = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/16QEgo-gsywiy0LMgZV_gWbzOEneJ2sJLlsp8ys9Q9HA/edit?gid=0#gid=0"),
				  #"Navegação 1" = Origem{[name = "Página1", ItemKind = "Table"]}[Data],
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Navegação 1", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"apoio para a view", type text}, {"descrição", type text}, {"potador", type text}}),
				    #"Texto Inserido Após o Delimitador" = Table.AddColumn(#"Tipo de coluna alterado", "Carteira", each Text.AfterDelimiter([descrição], "- "), type text),
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Texto Inserido Após o Delimitador", "xCODCART", each if [Carteira] = "Descontada" then 100001 else if [Carteira] = "Simples" then 100002 else if [Carteira] = "Vinculada" then 100003 else if [Carteira] = "Rec. Judicial" then 100004 else if [Carteira] = "Advocaticio" then 100005 else if [Carteira] = "Devolucao" then 100006 else if [Carteira] = "Renegociacao" then 100007 else if [Carteira] = "Transportadora" then 100008 else if [Carteira] = "Verba" then 100009 else 0),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Coluna Condicional Adicionada",{{"xCODCART", type number}})
				in
				    #"Tipo Alterado1"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

