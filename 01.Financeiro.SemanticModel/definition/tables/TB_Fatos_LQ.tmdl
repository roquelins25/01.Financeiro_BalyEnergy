	partition TB_Fatos_LQ = m
		mode: import
		queryGroup: _Fatos\CP_CR
		source = ```
				let
				  Origem = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				WITH 
				TB_EXTRATO AS (
				    SELECT 
				        E600MCC.CODEMP,
				        E600MCC.CODFIL,
				        E600MCC.NUMCCO,
				        E600MCC.NUMMCR,
				        E600MCC.TPTMCR,
				        E600MCC.SEQMCR,
				        E600RAT.CODTNS,
				        E600CCO.DESCCO,
				        E600MCC.HISMOV,
				        E600MCC.DATMOV,
				        CASE WHEN E600MCC.DEBCRE = 'D' THEN E600RAT.VLRRAT * (-1)
				             ELSE E600RAT.VLRRAT
				        END AS VLRRAT,
				        E600RAT.CTAFIN,
				        E091PLF.DESCTA,
				        E600RAT.CODCCU,
				        E600RAT.CTARED,
				        E044CCU.DESCCU,
				        E600MCC.DEBCRE
				    FROM E600MCC,
				         E600RAT,
				         E091PLF,
				         E600CCO,
				         E070EMP,
				         E044CCU
				    WHERE E600MCC.SITMCC <> 'I'
				      AND E600MCC.CODEMP = 1
				      --AND E600MCC.CODFIL = 1
				      AND E600MCC.CODEMP = E070EMP.CODEMP
				      AND E600RAT.CODEMP = E600MCC.CODEMP
				      AND E600RAT.NUMCCO = E600MCC.NUMCCO
				      AND E600RAT.DATMOV = E600MCC.DATMOV
				      AND E600RAT.SEQMOV = E600MCC.SEQMOV
				      AND E600CCO.CODEMP = E600MCC.CODEMP
				      AND E600CCO.NUMCCO = E600MCC.NUMCCO
				      AND E091PLF.CODEMP = E600RAT.CODEMP
				      AND E091PLF.CTAFIN = E600RAT.CTAFIN
				      AND E600RAT.CODEMP = E044CCU.CODEMP
				      AND E600RAT.CODCCU = E044CCU.CODCCU
				      AND NOT EXISTS (
				            SELECT 1 FROM E099UXC 
				            WHERE E099UXC.CODEMP = 1 
				              AND E099UXC.CODUSU = 261 
				              AND E099UXC.NUMCCO = E600MCC.NUMCCO)
				      AND E600MCC.SITMCC <> 'I'
				      AND E600CCO.CODTCC NOT IN ('1') -- RETIRA CONTAS DE MOTORISTAS
				),
				
				TB_TCR AS (
				    SELECT 
				        CODEMP,
				        CODFIL,
				        NUMTIT,
				        SITTIT,
				        CODTPT,
				        CODCLI
				    FROM E301TCR
				),
				
				TB_MCR AS (
				    SELECT
				        MCR.CODEMP,
				        MCR.CODFIL,
				        MCR.NUMTIT,
				        MCR.CODTPT,
				        MCR.SEQMOV,
				        MCR.CODTNS
				    FROM E301MCR MCR
				    WHERE MCR.DATMOV >= TO_DATE('2025-01-01','YYYY-MM-DD')
				),
				
				TB_CONSOLIDADO AS (
				    SELECT 
				        EX.CODEMP,
				        EX.CODFIL,
				        EX.NUMCCO,
				        EX.NUMMCR,
				        TCR.CODCLI,
				        TCR.SITTIT,
				        EX.CODTNS,
				        MCR.CODTNS AS CODTNSMCR,
				        EX.DESCCO,
				        EX.HISMOV,
				        EX.DATMOV,
				
				        CASE
				            WHEN MOD(TRUNC(EX.DATMOV) - DATE '2024-01-01', 7) = 5
				                 AND MCR.CODTNS = '90350'
				                 AND EX.NUMCCO NOT IN ('ITAU10917-0', 'SAFRA VINC', 'BMP SOCIEDADE', 'RED')
				            THEN EX.DATMOV + 3
				
				            WHEN MOD(TRUNC(EX.DATMOV) - DATE '2024-01-01', 7) <> 5
				                 AND (MCR.CODTNS = '90350' OR MCR.CODTNS IS NULL)
				                 AND EX.NUMCCO NOT IN ('ITAU10917-0', 'SAFRA VINC', 'BMP SOCIEDADE', 'RED')
				            THEN EX.DATMOV + 1
				
				            ELSE EX.DATMOV
				        END AS DATA_CONTA,
				
				        EX.VLRRAT, 
				        EX.CTAFIN,
				        EX.DESCTA,
				        EX.CODCCU,
				        EX.CTARED,
				        EX.DESCCU,
				        EX.DEBCRE
				
				    FROM TB_EXTRATO EX
				
				    LEFT JOIN TB_MCR MCR
				        ON MCR.CODEMP = EX.CODEMP 
				       AND MCR.CODFIL = EX.CODFIL 
				       AND MCR.SEQMOV = EX.SEQMCR
				       AND MCR.NUMTIT = EX.NUMMCR
				       AND MCR.CODTPT = EX.TPTMCR
				
				    LEFT JOIN TB_TCR TCR
				        ON TCR.CODEMP = MCR.CODEMP 
				       AND TCR.CODFIL = MCR.CODFIL
				       AND TCR.NUMTIT = MCR.NUMTIT
				       AND TCR.CODTPT = MCR.CODTPT
				
				    WHERE (TCR.SITTIT IS NULL OR TCR.SITTIT <> 'CA') -- retira os titulos cancelados
				)
				
				SELECT *
				FROM TB_CONSOLIDADO
				WHERE DATA_CONTA >= TO_DATE('2026-01-01','YYYY-MM-DD')
				   ", HierarchicalNavigation = true])
				
				 in 
				  Origem
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

