	partition TB_Fatos_LQ = m
		mode: import
		queryGroup: _Fatos\CP_CR
		source =
				let
				  Origem = Sql.Database("159.112.182.77", "I260220090255_ERPP", [CommandTimeout=#duration(0, 2, 0, 0), Query="WITH #(lf)#(tab)TB_Extrato as (#(lf)#(tab) SELECT #(lf)#(tab)#(tab) E600MCC.codemp,#(lf)#(tab)#(tab) E600MCC.CODFIL,#(lf)#(tab)#(tab) E600MCC.NUMCCO,#(lf)#(tab)#(tab) E600MCC.nummcr,#(lf)#(tab)#(tab) E600MCC.tptmcr,#(lf)#(tab)#(tab) E600MCC.SEQMCR,#(lf)#(tab)#(tab) E600RAT.CODTNS,#(lf)#(tab)#(tab) E600CCO.DESCCO,#(lf)#(tab)#(tab) E600MCC.hismov,#(lf)#(tab)#(tab) E600MCC.DATMOV,#(lf)#(tab)#(tab) Case when E600MCC.DEBCRE = 'D' then E600RAT.VLRRAT * (-1)#(lf)#(tab)#(tab) Else E600RAT.VLRRAT#(lf)#(tab)#(tab) End VLRRAT, #(lf)#(tab)#(tab) E600RAT.CTAFIN,#(lf)#(tab)#(tab) E091PLF.DESCTA,#(lf)#(tab)#(tab) E600RAT.CODCCU,#(lf)#(tab)#(tab) E600RAT.ctared,#(lf)#(tab)#(tab) E044CCU.DESCCU,#(lf)#(tab)#(tab) E600MCC.DEBCRE#(lf)#(tab) FROM sapiens_producao.E600MCC,#(lf)#(tab)#(tab)  sapiens_producao.E600RAT,#(lf)#(tab)#(tab)  sapiens_producao.E091PLF,#(lf)#(tab)#(tab)  sapiens_producao.E600CCO,#(lf)#(tab)#(tab)  sapiens_producao.E070EMP,#(lf)#(tab)#(tab)  sapiens_producao.E044CCU#(lf)#(tab) WHERE E600MCC.SITMCC <> 'I'#(lf)#(tab)#(tab) AND E600MCC.CODEMP = 1#(lf)#(tab)#(tab) AND E600MCC.CODFIL = 1#(lf)#(tab)#(tab) AND E600MCC.CODEMP = E070EMP.CODEMP#(lf)#(tab)#(tab) AND E600RAT.CODEMP = E600MCC.CODEMP#(lf)#(tab)#(tab) AND E600RAT.NUMCCO = E600MCC.NUMCCO#(lf)#(tab)#(tab) AND E600RAT.DATMOV = E600MCC.DATMOV#(lf)#(tab)#(tab) AND E600RAT.SEQMOV = E600MCC.SEQMOV#(lf)#(tab)#(tab) AND E600CCO.CODEMP = E600MCC.CODEMP#(lf)#(tab)#(tab) AND E600CCO.NUMCCO = E600MCC.NUMCCO#(lf)#(tab)#(tab) AND E091PLF.CODEMP = E600RAT.CODEMP#(lf)#(tab)#(tab) AND E091PLF.CTAFIN = E600RAT.CTAFIN#(lf)#(tab)#(tab) AND E600RAT.CODEMP = E044CCU.CODEMP#(lf)#(tab)#(tab) AND E600RAT.CODCCU = E044CCU.CODCCU#(lf)#(tab)#(tab) AND NOT EXISTS (#(lf)#(tab)#(tab) #(tab)SELECT 1 FROM sapiens_producao.E099UXC #(lf)#(tab)#(tab) #(tab)WHERE E099UXC.CODEMP = 1 #(lf)#(tab)#(tab)#(tab)  AND E099UXC.CODUSU = 261 #(lf)#(tab)#(tab)#(tab)  AND E099UXC.NUMCCO = E600MCC.NUMCCO)#(lf)#(tab)#(tab) AND E600MCC.SITMCC <> 'I'#(lf)#(tab)#(tab) AND E600CCO.CODTCC NOT IN ('1') -- RETIRA CONTAS DE MOTORISTAS#(lf)#(tab)#(tab)#(lf)#(tab)),#(lf)#(tab)TB_TCR AS(#(lf)#(tab)SELECT #(lf)#(tab)#(tab)CODEMP,#(lf)#(tab)#(tab)CODFIL,#(lf)#(tab)#(tab)NUMTIT,#(lf)#(tab)#(tab)SITTIT,#(lf)#(tab)#(tab)CODTPT,#(lf)#(tab)#(tab)CODCLI#(lf)#(tab)FROM E301TCR#(lf)#(tab)),#(lf)#(tab)TB_MCR AS(#(lf)#(tab)SELECT#(lf)#(tab)#(tab)MCR.CODEMP,#(lf)#(tab)#(tab)MCR.CODFIL,#(lf)#(tab)#(tab)MCR.numtit ,#(lf)#(tab)#(tab)MCR.codtpt ,#(lf)#(tab)#(tab)MCR.seqmov ,#(lf)#(tab)#(tab)MCR.codtns #(lf)#(tab)FROM E301MCR MCR#(lf)#(tab)WHERE MCR.datmov >= '20250101'#(lf)#(tab)),#(lf)TB_CONSOLIDADO as(#(lf)SELECT #(lf)#(tab)#(tab) EX.codemp,#(lf)#(tab)#(tab) EX.CODFIL,#(lf)#(tab)#(tab) EX.NUMCCO,#(lf)#(tab)#(tab) EX.nummcr,#(lf)#(tab)#(tab) TCR.CODCLI,#(lf)#(tab)#(tab) TCR.SITTIT,#(lf)#(tab)#(tab) EX.CODTNS,#(lf)#(tab)#(tab) MCR.CODTNS CODTNSMCR,#(lf)#(tab)#(tab) EX.DESCCO,#(lf)#(tab)#(tab) EX.hismov,#(lf)#(tab)#(tab) EX.DATMOV,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)    WHEN DATEPART(WEEKDAY, EX.DATMOV) = 6#(lf)#(tab)#(tab)         AND MCR.CODTNS = '90350'#(lf)#(tab)#(tab)         AND EX.NUMCCO NOT IN ('ITAU10917-0', 'SAFRA VINC', 'BMP SOCIEDADE', 'RED')#(lf)#(tab)#(tab)    THEN DATEADD(DAY, 3, EX.DATMOV)#(lf)#(tab)#(tab)#(lf)#(tab)#(tab)    WHEN DATEPART(WEEKDAY, EX.DATMOV) <> 6#(lf)#(tab)#(tab)         AND (MCR.CODTNS = '90350' OR MCR.CODTNS IS NULL)#(lf)#(tab)#(tab)         AND EX.NUMCCO NOT IN ('ITAU10917-0', 'SAFRA VINC', 'BMP SOCIEDADE', 'RED')#(lf)#(tab)#(tab)    THEN DATEADD(DAY, 1, EX.DATMOV)#(lf)#(tab)#(tab)#(lf)#(tab)#(tab)    ELSE EX.DATMOV#(lf)#(tab)#(tab)END AS DATA_CONTA,#(lf)#(tab)#(tab) EX.VLRRAT, #(lf)#(tab)#(tab) EX.CTAFIN,#(lf)#(tab)#(tab) EX.DESCTA,#(lf)#(tab)#(tab) EX.CODCCU,#(lf)#(tab)#(tab) EX.ctared,#(lf)#(tab)#(tab) EX.DESCCU,#(lf)#(tab)#(tab) EX.DEBCRE#(lf)FROM TB_Extrato EX#(lf)LEFT JOIN TB_MCR MCR#(lf)#(tab)   ON MCR.CODEMP = EX.CODEMP #(lf)#(tab)  AND MCR.CODFIL = EX.CODFIL #(lf)#(tab)  AND MCR.SEQMOV = EX.SEQMCR#(lf)#(tab)  AND MCR.NUMTIT = EX.NUMMCR#(lf)#(tab)  AND MCR.CODTPT = EX.TPTMCR#(lf)#(tab)  #(lf)LEFT JOIN TB_TCR TCR#(lf)#(tab)   ON TCR.CODEMP = MCR.CODEMP #(lf)#(tab)  AND TCR.CODFIL = MCR.CODFIL#(lf)#(tab)  AND TCR.NUMTIT = MCR.NUMTIT#(lf)#(tab)  AND TCR.CODTPT = MCR.CODTPT#(lf)#(tab)  #(lf)WHERE (TCR.SITTIT IS NULL OR TCR.SITTIT <> 'CA') -- retira os titulos que foram cancelados  #(lf))#(lf)  SELECT #(lf)  #(tab)*#(lf)  FROM TB_CONSOLIDADO#(lf)  WHERE DATA_CONTA >= '20260101'"])
				in
				  Origem

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

