	measure '03. Aux Dias' = ```
			
			VAR _dias = 
			[03. Dias]
			
			RETURN
			SWITCH(
			    TRUE(),
			    _dias = 0  , 10008,
			    
			    _dias < 0 && _dias >= -7 , 10007 ,
			    _dias >= -15 && _dias < -7, 10006,
			    _dias >= -30 && _dias < -15, 10005,
			    _dias >= -60 && _dias < -30, 10004,
			    _dias >= -90 && _dias < -60, 10003,
			    _dias >= -180 && _dias < -90, 10002,
			    _dias < -180, 10001,
			
			    _dias > 0 && _dias <= 7, 10009,
			    _dias > 7 && _dias <= 15, 10010,
			    _dias > 15 && _dias <= 30, 10011,
			    _dias > 30 && _dias <= 60, 10012,
			    _dias > 60 && _dias <= 90, 10013,
			    _dias > 90 && _dias <= 120, 10014,
			    _dias > 120 , 10015
			    )
			```
		formatString: 0
		displayFolder: 03. Auxiliares
		lineageTag: 9e8370f0-bdc5-49d4-8b6f-1a350ac9bf07

	measure '03. AUXFILTRO' =
			
			VAR vSELECT = VALUE( SELECTEDVALUE( TB_AUXtempo[ID] ) )
			VAR vMEDIDA = [03. Aux Dias]
			VAR vRESULT =
			SWITCH(
			    TRUE(),
			    vSELECT = 10001 && vMEDIDA = 10001, 1,
			    vSELECT = 10002 && vMEDIDA = 10002, 1,
			    vSELECT = 10003 && vMEDIDA = 10003, 1,
			    vSELECT = 10004 && vMEDIDA = 10004, 1,
			    vSELECT = 10005 && vMEDIDA = 10005, 1,
			    vSELECT = 10006 && vMEDIDA = 10006, 1,
			    vSELECT = 10007 && vMEDIDA = 10007, 1,
			
			    vSELECT = 10008 && vMEDIDA = 10008, 1,
			
			    vSELECT = 10009 && vMEDIDA = 10009, 1,
			    vSELECT = 10010 && vMEDIDA = 10010, 1,
			    vSELECT = 10011 && vMEDIDA = 10011, 1,
			    vSELECT = 10012 && vMEDIDA = 10012, 1,
			    vSELECT = 10013 && vMEDIDA = 10013, 1,
			    vSELECT = 10014 && vMEDIDA = 10014, 1,
			    vSELECT = 10015 && vMEDIDA = 10015, 1,
			    0 )
			RETURN
			vRESULT
		formatString: 0
		displayFolder: 03. Auxiliares
		lineageTag: 564b7157-6d9e-48db-b6b3-d8baaed00dcd

