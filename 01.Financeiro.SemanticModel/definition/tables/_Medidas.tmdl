	measure '05.HTML CARD A VENCER' = ```
			
			-- Select
			VAR vANO = SELECTEDVALUE( 'CALENDARIO DAX'[Ano-Mes] )
			
			VAR vMESANTERIOR = 
			FORMAT(
			    EDATE(MAX('CALENDARIO DAX'[Date]), 1),
			    "mmm-yy"
			)
			VAR vMES1 = 
			FORMAT(
			    EDATE(MAX('CALENDARIO DAX'[Date]), 2),
			    "mmm-yy"
			)
			---- Calculos
			VAR _TOTALGERAL = CALCULATE( [01. Valor Aberto], ALL( 'CALENDARIO DAX' ), TB_AUXtempo[Tipo] = "A Vencer" )
			
			VAR _VencendoHOJE = CALCULATE( [01. Valor Aberto], ALL('CALENDARIO DAX'), TB_AUXtempo[Tipo] = "HOJE" )
			
			VAR _TOTALAB =  [01. Valor Aberto]
			
			VAR _TotalMesAnt = CALCULATE( [01. Valor Aberto], ALL( 'CALENDARIO DAX' ), 'CALENDARIO DAX'[Ano-Mes] = vMESANTERIOR )
			
			VAR _TotalMes1 = CALCULATE( [01. Valor Aberto], ALL( 'CALENDARIO DAX' ), 'CALENDARIO DAX'[Ano-Mes] = vMES1 )
			
			VAR _TotalMes2 = 
			    VAR DataLimite =
			        EDATE(MAX('CALENDARIO DAX'[Date]), 3)
			
			    RETURN
			    CALCULATE(
			        [01. Valor Aberto],
			        FILTER(
			            ALL('CALENDARIO DAX'),
			            'CALENDARIO DAX'[Date] >= EOMONTH(DataLimite, 0)
			        )
			    )
			
			
			RETURN
			
			"
			<!DOCTYPE html>
			<html lang='pt-BR'>
			<head>
			  <meta charset='UTF-8'>
			  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
			  <title>Card Inadimplência</title>
			  <style>
			    * { box-sizing: border-box; margin: 0; padding: 0; }
			
			    body {
			      display: flex;
			      justify-content: center;
			      align-items: center;
			      min-height: 100vh;
			      font-family: 'Segoe UI', Arial, sans-serif;
			    }
			
			    /* ── Flip container ── */
			    .flip-wrapper {
			      width: 277px;
			      height: 145px;
			      perspective: 900px;
			    }
			
			    .flip-inner {
			      width: 100%;
			      height: 100%;
			      position: relative;
			      transform-style: preserve-3d;
			      transition: transform 0.55s cubic-bezier(.4,0,.2,1);
			    }
			
			    .flip-wrapper:hover .flip-inner {
			      transform: rotateY(180deg);
			    }
			
			    /* ── Faces comuns ── */
			    .face {
			      position: absolute;
			      inset: 0;
			      backface-visibility: hidden;
			      -webkit-backface-visibility: hidden;
			      border: 1.5px solid #FFCD00;
			      border-radius: 12px;
			      padding: 12px 12px 14px;
			    }
			
			    /* ── Frente ── */
			    .front {
			      background: #F5F5F5;
			    }
			
			    .header {
			      display: flex;
			      justify-content: space-between;
			      align-items: center;
			      margin-bottom: 6px;
			    }
			
			    .title {
			      font-size: 10px;
			      font-weight: 600;
			      color: #828282;
			      letter-spacing: 0.4px;
			      text-transform: uppercase;
			    }
			
			    .badge {
			      background: #B5FFC5;
			      color: #11A141;
			      font-size: 10px;
			      font-weight: 700;
			      padding: 3px 10px;
			      border-radius: 20px;
			    }
			
			    .main-value {
			      font-size: 32px;
			      font-weight: 800;
			      color: #1a1a1a;
			      letter-spacing: -0.5px;
			      margin: 6px 0 10px;
			      line-height: 1.7;
			    }
			
			    .divider {
			      border: none;
			      border-top: 1px solid #FFCD00;
			      margin: 10px 0;
			    }
			
			    .footer {
			      display: flex;
			      align-items: center;
			      gap: 6px;
			    }
			
			    .footer-value {
			      font-size: 14px;
			      font-weight: 700;
			      color: #393939;
			    }
			
			    .footer-label {
			      font-size: 11px;
			      color: #828282;
			      flex: 1;
			    }
			
			    .flip-hint {
			      font-size: 14px;
			      color: #bbb;
			    }
			
			    /* ── Verso ── */
			    .back {
			      background: #1a1a1a;
			      transform: rotateY(180deg);
			      display: flex;
			      flex-direction: column;
			      justify-content: center;
			      gap: 0;
			    }
			
			    .back-title {
			      font-size: 9px;
			      font-weight: 700;
			      color: #FFCD00;
			      text-transform: uppercase;
			      letter-spacing: 0.1px;
			      margin-bottom: 8px;
			    }
			
			    .back-row {
			      display: flex;
			      justify-content: space-between;
			      align-items: center;
			      padding: 2px 0;
			      border-bottom: 1px solid #2e2e2e;
			      font-size: 11px;
			    }
			
			    .back-row:last-child { border-bottom: none; }
			
			    .back-row .lbl { color: #888; }
			    .back-row .val { font-weight: 700; color: #f0f0f0; }
			    .back-row .val.up   { color: #FFCD00; }
			    .back-row .val.down { color: #f87171; }
			  </style>
			</head>
			<body>
			
			  <div class='flip-wrapper'>
			    <div class='flip-inner'>
			
			      <!-- FRENTE -->
			      <div class='face front'>
			        <div class='header'>
			          <span class='title'>A VENCER</span>
			        </div>
			        <div class='main-value'>"&fxFORMAT(_TOTALGERAL,4)&"</div>
			        <hr class='divider'>
			        <div class='footer'>
			          <span class='footer-value'>"&fxFORMAT(_VencendoHOJE,4)&"</span>
			          <span class='footer-label'> Vencendo Hoje </span>
			          <span class='flip-hint'>›</span>
			        </div>
			      </div>
			
			      <!-- VERSO -->
			      <div class='face back'>
			        <div class='back-title'> Comparativo Mensal </div>
			        <div class='back-row'>
			          <span class='val up'>"&vANO&"</span>
			          <span class='val up'>"&fxFORMAT(_TOTALAB,4)&"</span>
			        </div>
			        <div class='back-row'>
			          <span class='lbl'>"&vMESANTERIOR&"</span>
			          <span class='val'>"&fxFORMAT(_TotalMesAnt,4)&"</span>
			        </div>
			        <div class='back-row'>
			          <span class='lbl'>"&vMES1&"</span>
			          <span class='val'>"&fxFORMAT(_TotalMes1, 4 )&"</span>
			        </div>
			        <div class='back-row'>
			          <span class='lbl'>Outro Meses</span>
			          <span class='val'>"& fxFORMAT( _TotalMes2, 4 ) &"</span>
			        </div>
			      </div>
			
			    </div>
			  </div>
			
			</body>
			</html>
			
			"
			```
		displayFolder: 05. HTML
		lineageTag: 15316810-1a59-48d4-9a17-7069c0e9927c

	measure '01. Valor Aberto Ano Anterior' =
			
			CALCULATE(
			    [01. Valor Aberto],
			    SAMEPERIODLASTYEAR( 'CALENDARIO DAX'[Date] )
			)
		displayFolder: 01. Valores Totais
		lineageTag: 5210bd54-30f9-46e6-be2a-4f82ca9d1fee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '01. Valor AB Operacao' = ```
			
			VAR vREDE = 
			CALCULATE( [01. Valor Aberto], CROSSFILTER( TB_OPRede[codgre], TB_Rede[codgre], Both ) )
			
			VAR vUF = 
			CALCULATE(
			    [01. Valor Aberto],
			    USERELATIONSHIP(
			        TB_OPUf[UF],
			        TB_CLI[sigufs]
			    ),
			    KEEPFILTERS(
			    FILTER(
			        ALL(TB_CLI),
			        NOT TB_CLI[codgre] IN ALL(TB_OPRede[codgre])
			    ) )
			)
			
			VAR vTOTAL = 
			SWITCH(
			    TRUE(),
			    ISINSCOPE( TB_Operacao[OP] ), vUF + vREDE ,
			    [01. Valor Aberto])
			
			RETURN
			vTOTAL
			```
		lineageTag: fb79b868-7dae-47d5-acc6-ff637d577546

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '02. Qtde AB Operacao' = ```
			
			VAR vREDE = 
			CALCULATE( [02. Quantidade Titulos], CROSSFILTER( TB_OPRede[codgre], TB_Rede[codgre], Both ) )
			
			VAR vUF = 
			CALCULATE(
			    [02. Quantidade Titulos],
			    USERELATIONSHIP(
			        TB_OPUf[UF],
			        TB_CLI[sigufs]
			    ),
			    KEEPFILTERS(
			    FILTER(
			        ALL(TB_CLI),
			        NOT TB_CLI[codgre] IN ALL(TB_OPRede[codgre])
			    ) )
			)
			
			RETURN
