	measure '01. % Acumulado UF' =
			
			VAR ValorAtual = [01. % Valor Total UF]
			
			RETURN
			SUMX(
			    FILTER(
			        ALLSELECTED(TB_CLI[sigufs]),
			        [01. % Valor Total UF] >= ValorAtual
			    ),
			    [01. % Valor Total UF]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Valores Totais\%
		lineageTag: 1e7c7f87-5434-4723-95a3-4ca5ccce9a46

	measure '01. % Valor Total UF' = ```
			
			DIVIDE(
			    [01. Valor AB Total Vencidas] , 
			CALCULATE(
			    [01. Valor AB Total Vencidas],
			    ALL( TB_CLI[sigufs] )
			) )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Valores Totais\%
		lineageTag: 5f7b01ee-f43e-4d28-9df7-7aa0cf55310c

	measure '.....Titulo_ext' =
			
