		lineageTag: a2aa7fb5-a36c-4827-b089-bad5cecfe315

	measure '04. Valor Aberto CP' = ```
			
			// Mostra em moto calendario Auxiliar 
			VAR vSELECTMESES = SELECTEDVALUE( yTB_01[yTB_01] )
			VAR vUltimaData =
			    LASTDATE ( 'CALENDARIO DAX'[Date] )
			
			VAR vPrimeiraData =
			    DATE (
			        YEAR ( EDATE ( vUltimaData, - vSELECTMESES ) ),
			        MONTH ( EDATE ( vUltimaData,( - vSELECTMESES) + 1 ) ),
			        1
			    )
			VAR vPimeiraDataPositivo = 
			    DATE (
			        YEAR ( EDATE ( vUltimaData,  vSELECTMESES ) ),
			        MONTH ( EDATE ( vUltimaData, vSELECTMESES ) ),
			        1
			    )
			VAR vMeses=
			    VAR vNegativo =
			        CALCULATE(
			            [01. Valor AB CP],
			            DATESBETWEEN( 'CALENDARIO DAX'[Date], vPrimeiraData, vUltimaData ),
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[Ano-Mes] )
			        )
			    VAR vPositivo =
			        CALCULATE(
			            [01. Valor AB CP],
			            DATESBETWEEN( 'CALENDARIO DAX'[Date], vUltimaData, vPimeiraDataPositivo  ),
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[Ano-Mes] )
			        )
			    RETURN
			        IF( SELECTEDVALUE( 'CALENDARIO DAX'[Vencidos?] ) = "Vencidas", vNegativo, vPositivo )
			------------------------------ ANO --------------------
			
			VAR vGeralAno = 
			    VAR vNegativo =
			    IF(
			        HASONEFILTER( 'CALENDARIO DAX'[Ano-Mes] ),
			            CALCULATE(
			                [01. Valor AB CP],
			                TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] ),
			                FILTER(
			                    ALL( 'CALENDARIO DAX' ),
			                    'CALENDARIO DAX'[Ano] <= SELECTEDVALUE( 'CALENDARIO DAX'[Ano] )
			                )
			            ),
			                CALCULATE(
			                [01. Valor AB CP],
			                TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] )
			                )
			        )
			    VAR vPositivo =
			    IF(
			        HASONEFILTER( 'CALENDARIO DAX'[Ano-Mes] ),
			            CALCULATE(
			                [01. Valor AB CP],
			                TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] ),
			                FILTER(
			                    ALL( 'CALENDARIO DAX' ),
			                    'CALENDARIO DAX'[Ano] >= SELECTEDVALUE( 'CALENDARIO DAX'[Ano] )
			                )
			            ),
			                CALCULATE(
			                [01. Valor AB CP],
			                TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] )
			                )
			        )
			    RETURN
			        IF( SELECTEDVALUE( 'CALENDARIO DAX'[Vencidos?] ) = "Vencidas", vNegativo, vPositivo )
			--------------------------------- Total Geral ------------------------------
			VAR vTotalAberto = 
			CALCULATE( [01. Valor AB CP] , ALL( 'CALENDARIO DAX' ) )
			
			VAR vPercentTotal = 
			DIVIDE( vTotalAberto , CALCULATE( [01. Valor AB CP] , ALL( TB_TIPO ), ALL( 'CALENDARIO DAX' ) ), 0 )
			---------------------------------- Resultado ---------------------------------
			RETURN
			IF(
			    ISBLANK( vTotalAberto ), BLANK() ,
			IF( 
			    ISINSCOPE( xCalendarioTable[Periodo] ),
			        SWITCH(
			            SELECTEDVALUE( xCalendarioTable[Cod. Periodo] ),
			            1, vTotalAberto,
			            2, FORMAT( vPercentTotal, "Percent" ),
			            4, vMeses,
			            5, IF( vGeralAno = 0, BLANK(), vGeralAno )
			        ),
			    vPercentTotal )
			)
			```
		formatString: #,0
		displayFolder: 04. DRE
		lineageTag: e31fda98-11d7-4f78-8993-9f59a21dd043

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '01. % Valor Total CP' = ```
			
			VAR _TOTAL = 
			CALCULATE(
			    [04. Valor Aberto CP],
			    ALL( TB_TIPO )
			)
			VAR vRESULT = 
			DIVIDE( [04. Valor Aberto CP], _TOTAL, 0 )
			
			RETURN
			vRESULT
			```
