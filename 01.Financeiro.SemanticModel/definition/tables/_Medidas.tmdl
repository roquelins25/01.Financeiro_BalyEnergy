	measure HTML_Calendario = ```
			
			VAR MesRef        = MAX ( 'CALENDARIO DAX'[Date] )
			VAR PrimeiroDia   = DATE ( YEAR ( MesRef ), MONTH ( MesRef ), 1 )
			VAR UltimoDia     = EOMONTH ( PrimeiroDia, 0 )
			VAR OffsetSemana  = WEEKDAY ( PrimeiroDia, 1 ) - 1     -- quantas células vazias antes do dia 1
			
			VAR DiasDoMes = 
			    SUMMARIZE(
			        'CALENDARIO DAX',
			        'CALENDARIO DAX'[Date],
			        "DiaSemana",  WEEKDAY ( [Date], 1 ) - 1,
			        "Receber", [01. Valor Previsto a Receber],
			        "Pagar", [01. Valor AB CP]
			    )
			
			VAR CelulasVazias =
			    CONCATENATEX ( GENERATESERIES ( 1, OffsetSemana ), "<div class='dia vazio'></div>", "" )
			
			VAR CelulasDias =
			    CONCATENATEX (
			        DiasDoMes,
			        VAR Saldo = [Receber] + [Pagar]
			        VAR EhFDS = [DiaSemana] = 0 || [DiaSemana] = 6
			        VAR DiaHoje = [Date] = TODAY()
			        RETURN
			            "<div class='dia" & IF( DiaHoje, " hoje", "" ) & IF ( EhFDS, " fds", "" ) & "'>" &
			                "<div class='numero'>" & DAY ( [Date] ) & "</div>" &
			                IF ( NOT ISBLANK( [Receber] ) ,
			                    "<div class='linha-valor receber'><span>Receber</span><span>R$ "
			                        & FORMAT ( [Receber], "#,##0" ) & "</span></div>" ) &
			                IF ( NOT ISBLANK( [Pagar] ) ,
			                    "<div class='linha-valor pagar'><span>Pagar</span><span>R$ "
			                        & FORMAT ( [Pagar], "#,##0" ) & "</span></div>" ) &
			                IF ( NOT ISBLANK( [Receber] )  || NOT ISBLANK( [Pagar] ) ,
			                    "<div class='saldo-dia" & IF ( Saldo < 0, " negativo", "" ) & "'>Saldo R$ "
			                        & FORMAT ( Saldo, "#,##0" ) & "</div>" ) &
			            "</div>",
			        "", [Date], ASC
			    )
			
			RETURN
			"<html><head><style>" &
			    "*{margin:0;padding:0;box-sizing:border-box;font-family:Segoe UI,Arial,sans-serif;}" &
			    ".calendario{display:grid;grid-template-columns:0.4fr 1fr 1fr 1fr 1fr 1fr 0.4fr;;gap:8px;padding:12px;background:#f1f5f9;}" &
			    ".dia-semana{background:#1e293b;color:#fff;padding:8px;text-align:center;border-radius:6px;font-size:12px;font-weight:600;}" &
			    ".dia{background:#fff;border-radius:8px;min-height:100px;padding:6px;border:1px solid #e2e8f0;font-size:11px;}" &
			    ".dia.hoje{ border:2px solid #2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.15);}" &
			    ".dia.fds{background:#f8fafc;} .dia.vazio{background:transparent;border:none; min-heigth: 20px; padding:0}" &
			    ".numero{font-weight:700;color:#64748b;}" &
			    ".linha-valor{padding:3px 5px;border-radius:5px;margin-top:3px;display:flex;justify-content:space-between;}" &
			    ".receber{background:#ecfdf9;color:#0d9488;} .pagar{background:#fefef2;color:#dc7e26;}" &
			    ".saldo-dia{margin-top:6px;padding:6px 5px;border-radius:5px;font-weight:700;fonte-size:12pc; text-align:center; background:#eff6ff; color:#1d4ed8;}" &
			    ".saldo-dia.negativo{background:#fef2f2;color:#b91c1c;}" &
			"</style></head><body>" &
			"<div class='calendario'>" &
			    "<div class='dia-semana'>Dom</div><div class='dia-semana'>Seg</div><div class='dia-semana'>Ter</div>" &
			    "<div class='dia-semana'>Qua</div><div class='dia-semana'>Qui</div><div class='dia-semana'>Sex</div><div class='dia-semana'>Sáb</div>" &
			    CelulasVazias & CelulasDias &
			"</div></body></html>"
			```
		displayFolder: 05. HTML
		lineageTag: 838cc1a1-39c8-4adb-8518-fd36f728b3a6

