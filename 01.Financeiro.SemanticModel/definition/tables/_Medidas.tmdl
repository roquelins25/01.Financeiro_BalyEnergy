	measure '01. % Indice Inadimplencia Operacao' = ```
			
			VAR vREDE = 
			CALCULATE( [01 % Indice Inadimplencia], CROSSFILTER( TB_OPRede[codgre], TB_Rede[codgre], Both ) )
			
			VAR vUF = 
			CALCULATE(
			    [01 % Indice Inadimplencia],
			    USERELATIONSHIP(
			        TB_OPUf[UF],
			        TB_CLI[sigufs]
			    ),
			    KEEPFILTERS(
			    FILTER(
			        ALL(TB_CLI),
			        NOT TB_CLI[codgre] IN ALL(TB_OPRede[codgre])
			    ) )
			)
			
			VAR vTOTAL = 
			SWITCH(
			    TRUE(),
			    ISINSCOPE( TB_Operacao[OP] ), vUF + vREDE ,
			    [01 % Indice Inadimplencia])
			
			RETURN
			vTOTAL
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Valores Totais\%
		lineageTag: fb26498a-db58-4336-b0ab-ca422899fb85

	measure '04. Cor' = ```
			
			VAR vMesSelect = CALCULATE( SELECTEDVALUE( 'CALENDARIO DAX'[Ano-Mes] ), 'CALENDARIO DAX'[MesAtual] = "S" )
			VAR vAnoSelect = SELECTEDVALUE( 'CALENDARIO DAX'[Ano] )
			VAR vReturn = 
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE( xCalendarioTable[Cod. Periodo] ) = 1, "#F5F5F5",
			    SELECTEDVALUE( xCalendarioTable[Cod. Periodo] ) = 4 && SELECTEDVALUE( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ) = vMesSelect, "#F5F5F5",
			    BLANK() )
			RETURN
			vReturn
			```
		displayFolder: 04. DRE
		lineageTag: bd271968-ce0d-4829-8e35-33dff45cbb9b

