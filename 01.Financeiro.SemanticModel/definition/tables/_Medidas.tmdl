			RETURN
			
			"
			<!DOCTYPE html>
			<html lang='pt-BR'>
			<head>
			<meta charset='UTF-8'>
			<title>Mapa Inadimplência por UF</title>
			<style>
			  * { box-sizing: border-box; }
			  html, body {
			    margin: 0; padding: 0; height: 100%;
			    background: #eef1f3;
			    font-family: Arial, Helvetica, sans-serif;
			    display: flex; align-items: center; justify-content: center;
			  }
			  .container {
			    position: relative;
			    width: min(92vw, 450px);
			  }
			  svg {
			    width: 100%;
			    height: auto;
			    display: block;
			    overflow: visible;
			  }
			
			  /* Estados */
			  .estado {
			    stroke: #4a4a4a;
			    stroke-width: 1.1;
			    cursor: pointer;
			    transition: filter 0.15s ease, stroke-width 0.15s ease;
			  }
			  .estado:hover {
			    filter: brightness(0.82);
			    stroke: #1a1a1a;
			    stroke-width: 2.5;
			  }
			
			  /* Rotulo fixo de % sobre o total, sempre visivel */
			  .estado-pct {
			    fill: #1a1a1a;
			    font-weight: 800;
			    paint-order: stroke fill;
			    stroke: #fff;
			    stroke-width: 3px;
			    stroke-linejoin: round;
			    pointer-events: none;
			    dominant-baseline: middle;
			  }
			
			  /* Tooltip — sem fundo, só texto com contorno p/ legibilidade */
			  .tooltip-group {
			    opacity: 0;
			    pointer-events: none;
			    transition: opacity 0.12s ease;
			  }
			  .tooltip-text {
			    fill: #1a1a1a;
			    paint-order: stroke fill;
			    stroke: #fff;
			    stroke-width: 4px;
			    stroke-linejoin: round;
			  }
			  .tooltip-sigla {
			    font-size: 13px;
			    font-weight: 700;
			  }
			  .tooltip-valor {
			    font-size: 15px;
			    font-weight: 800;
			  }
			
			  /* Regras de hover -> tooltip (CSS puro, via :has) */
			  svg:has(#AC:hover) #tooltip-AC { opacity: 1; }
			svg:has(#AL:hover) #tooltip-AL { opacity: 1; }
			svg:has(#AM:hover) #tooltip-AM { opacity: 1; }
			svg:has(#AP:hover) #tooltip-AP { opacity: 1; }
			svg:has(#BA:hover) #tooltip-BA { opacity: 1; }
			svg:has(#CE:hover) #tooltip-CE { opacity: 1; }
			svg:has(#ES:hover) #tooltip-ES { opacity: 1; }
			svg:has(#GO:hover) #tooltip-GO { opacity: 1; }
			svg:has(#MA:hover) #tooltip-MA { opacity: 1; }
			svg:has(#MG:hover) #tooltip-MG { opacity: 1; }
			svg:has(#MS:hover) #tooltip-MS { opacity: 1; }
			svg:has(#MT:hover) #tooltip-MT { opacity: 1; }
			svg:has(#PA:hover) #tooltip-PA { opacity: 1; }
			svg:has(#PB:hover) #tooltip-PB { opacity: 1; }
			svg:has(#PE:hover) #tooltip-PE { opacity: 1; }
			svg:has(#PI:hover) #tooltip-PI { opacity: 1; }
			svg:has(#PR:hover) #tooltip-PR { opacity: 1; }
			svg:has(#RJ:hover) #tooltip-RJ { opacity: 1; }
			svg:has(#RN:hover) #tooltip-RN { opacity: 1; }
			svg:has(#RO:hover) #tooltip-RO { opacity: 1; }
			svg:has(#RR:hover) #tooltip-RR { opacity: 1; }
			svg:has(#RS:hover) #tooltip-RS { opacity: 1; }
			svg:has(#SC:hover) #tooltip-SC { opacity: 1; }
			svg:has(#SE:hover) #tooltip-SE { opacity: 1; }
			svg:has(#SP:hover) #tooltip-SP { opacity: 1; }
			svg:has(#TO:hover) #tooltip-TO { opacity: 1; }
			svg:has(#DF:hover) #tooltip-DF { opacity: 1; }
			
			   /* Legenda */
			  .legend {
			    position: fixed;
			    bottom: 14px;
			    right: 14px;
			    background: #fff;
			    border-radius: 6px;
			    padding: 10px 12px;
			    box-shadow: 0 1px 6px rgba(0,0,0,0.3);
			    font-size: 12px;
			  }
			  .legend-title {
			    font-weight: bold;
			    margin-bottom: 6px;
			  }
			  .legend-item {
			    display: flex;
			    align-items: center;
			    gap: 6px;
			    margin-bottom: 2px;
			  }
			  .legend-swatch {
			    width: 16px; height: 16px;
			    border-radius: 3px;
			    display: inline-block;
			    flex-shrink: 0;
			  }
			 
			  h1 {
			    text-align: center;
			    font-size: 18px;
			    color: #333;
			    margin: 16px 0 4px;
			  }
			
			</style>
			</head>
