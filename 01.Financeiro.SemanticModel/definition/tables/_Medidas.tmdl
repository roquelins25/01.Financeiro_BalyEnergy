	measure '01. Valor AB Operacao' = ```
			
			VAR vREDE = 
			CALCULATE( [01. Valor Aberto], CROSSFILTER( TB_OPRede[codgre], TB_Rede[codgre], Both ) )
			
			VAR vUF = 
			CALCULATE(
			    [01. Valor Aberto],
			    USERELATIONSHIP(
			        TB_OPUf[UF],
			        TB_CLI[sigufs]
			    ),
			    KEEPFILTERS(
			    FILTER(
			        ALL(TB_CLI),
			        NOT TB_CLI[codgre] IN ALL(TB_OPRede[codgre])
			    ) )
			)
			
			VAR vTOTAL = 
			SWITCH(
			    TRUE(),
			    ISINSCOPE( TB_Operacao[OP] ), vUF + vREDE ,
			    [01. Valor Aberto])
			
			RETURN
			vTOTAL
			```
		displayFolder: 01. Valores Totais\Auxiliares\CR
		lineageTag: fb79b868-7dae-47d5-acc6-ff637d577546

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '02. Qtde AB Operacao' = ```
			
			VAR vREDE = 
			CALCULATE( [02. Quantidade Titulos AB], CROSSFILTER( TB_OPRede[codgre], TB_Rede[codgre], Both ) )
			
			VAR vUF = 
			CALCULATE(
			    [02. Quantidade Titulos AB],
			    USERELATIONSHIP(
			        TB_OPUf[UF],
			        TB_CLI[sigufs]
			    ),
			    KEEPFILTERS(
			    FILTER(
			        ALL(TB_CLI),
			        NOT TB_CLI[codgre] IN ALL(TB_OPRede[codgre])
			    ) )
