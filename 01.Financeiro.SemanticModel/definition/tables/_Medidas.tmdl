	measure '04. Valor Aberto CR' = ```
			
			// Mostra em moto calendario Auxiliar 
			VAR vSELECTMESES = SELECTEDVALUE( yTB_01[yTB_01] )
			VAR vUltimaData =
			    LASTDATE ( 'CALENDARIO DAX'[Date] )
			
			VAR vPrimeiraData =
			    DATE (
			        YEAR ( EDATE ( vUltimaData, - vSELECTMESES ) ),
			        MONTH ( EDATE ( vUltimaData,- vSELECTMESES ) ),
			        1
			    )
			VAR vPimeiraDataPositivo = 
			    DATE (
			        YEAR ( EDATE ( vUltimaData, + vSELECTMESES ) ),
			        MONTH ( EDATE ( vUltimaData,+ vSELECTMESES ) ),
			        1
			    )
			VAR vMeses=
			    VAR vNegativo =
			        CALCULATE(
			            [01. Valor Aberto],
			            DATESBETWEEN( 'CALENDARIO DAX'[Date], vPrimeiraData, vUltimaData ),
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[Ano-Mes] )
			        )
			    VAR vPositivo =
			        CALCULATE(
			            [01. Valor Aberto],
			            DATESBETWEEN( 'CALENDARIO DAX'[Date], vUltimaData, vPimeiraDataPositivo  ),
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[Ano-Mes] )
			        )
			    RETURN
			        IF( SELECTEDVALUE( 'CALENDARIO DAX'[Vencidos?] ) = "Vencidas", vNegativo, vPositivo )
			------------------------------ ANO --------------------
			
			VAR vGeralAno = 
			IF(
			    HASONEFILTER( 'CALENDARIO DAX'[Ano-Mes] ),
			        CALCULATE(
			            [01. Valor Aberto],
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] ),
			            FILTER(
			                ALL( 'CALENDARIO DAX' ),
			                'CALENDARIO DAX'[Ano] <= SELECTEDVALUE( 'CALENDARIO DAX'[Ano] )
			            )
			        ),
			            CALCULATE(
			            [01. Valor Aberto],
			            TREATAS( VALUES( xCalendarioTable[CALENDARIO DAX_Ano-Mes] ), 'CALENDARIO DAX'[AnoTEXT] )
			            )
			    )
			--------------------------------- Total Geral ------------------------------
			VAR vTotalAberto = 
			CALCULATE( [01. Valor Aberto] , ALL( 'CALENDARIO DAX' ) )
			
			VAR vPercentTotal = 
			CALCULATE( [01. % Valor Total CR], ALL( 'CALENDARIO DAX' ) )
			---------------------------------- Resultado ---------------------------------
			RETURN
			IF(
			    ISBLANK( vTotalAberto ), BLANK() ,
			IF( 
			    ISINSCOPE( xCalendarioTable[Periodo] ),
			        SWITCH(
			            SELECTEDVALUE( xCalendarioTable[Cod. Periodo] ),
			            1, vTotalAberto,
			            2, FORMAT( vPercentTotal, "Percent" ),
			            4, vMeses,
			            5, IF( vGeralAno = 0, BLANK(), vGeralAno )
			        ),
			    vPercentTotal )
			)
			```
		displayFolder: 04. DRE
		lineageTag: 5b067920-9576-4c13-a5f9-8b3a6b541645

		annotation PBI_FormatHint = {"isGeneralNumber":true}

