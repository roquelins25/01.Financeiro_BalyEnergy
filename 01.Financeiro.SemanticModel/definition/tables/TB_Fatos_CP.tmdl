	partition TB_Fatos_CP = m
		mode: import
		queryGroup: _Fatos\CP_CR
		source = ```
				let
				  Fonte = 
				  Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				SELECT
				    E501TCP.CODEMP,
				    E070EMP.NOMEMP,
				
				    CASE
				        WHEN E095FOR.CODFOR IN (36223, 40797, 2491)
				            THEN TO_CHAR(E095FOR.CODFOR)
				        ELSE E501TCP.CODTPT
				    END AS TIPO,
				
				    E095FOR.CODFOR,
				    E095FOR.NOMFOR,
				    E501TCP.NUMTIT,
				    E044CCU.CODCCU,
				    E044CCU.DESCCU,
				    E091PLF.CTAFIN,
				    E091PLF.DESCTA,
				    E501TCP.SITTIT,
				    E501TCP.DATEMI,
				    E501TCP.DATENT,
				
					 CASE
					    WHEN MOD(TRUNC(E501TCP.VCTPRO) - DATE '2024-01-01', 7) = 5 THEN E501TCP.VCTPRO + 2  -- sábado
					    WHEN MOD(TRUNC(E501TCP.VCTPRO) - DATE '2024-01-01', 7) = 6 THEN E501TCP.VCTPRO + 1  -- domingo
					    ELSE E501TCP.VCTPRO
					END AS VCTPRO,
				
				    CASE
				        WHEN E091PLF.CTAFIN IS NULL THEN (E501TCP.VLRABE * -1)
				        WHEN E091PLF.CTAFIN IS NOT NULL THEN (E501RAT.VLRRAT * -1)
				    END AS VLRABE,
				
				    CASE
				        WHEN E091PLF.CTAFIN IS NULL THEN (E501TCP.VLRORI * -1)
				        WHEN E091PLF.CTAFIN IS NOT NULL THEN (E501RAT.VLRRAT * -1)
				    END AS VLRORI,
				
				    CASE
				        WHEN (E043PCM.DESPAR IS NULL) OR (E043PCM.DESPAR = '') THEN 'Sem C. Financeira'
				        ELSE E043PCM.DESPAR
				    END AS DESPAR
				
				FROM E501TCP
				
				LEFT OUTER JOIN E501RAT
				    ON E501RAT.CODEMP = E501TCP.CODEMP
				   AND E501RAT.CODFIL = E501TCP.CODFIL
				   AND E501RAT.NUMTIT = E501TCP.NUMTIT
				   AND E501RAT.CODTPT = E501TCP.CODTPT
				   AND E501RAT.CODFOR = E501TCP.CODFOR
				   AND E501RAT.SOMSUB = 1
				
				LEFT OUTER JOIN E070EMP
				    ON E501TCP.CODEMP = E070EMP.CODEMP
				
				LEFT OUTER JOIN E095FOR
				    ON E501TCP.CODFOR = E095FOR.CODFOR
				
				LEFT OUTER JOIN E044CCU
				    ON E501RAT.CODEMP = E044CCU.CODEMP
				   AND E501RAT.CODCCU = E044CCU.CODCCU
				
				LEFT OUTER JOIN E091PLF
				    ON E501RAT.CODEMP = E091PLF.CODEMP
				   AND E501RAT.CTAFIN = E091PLF.CTAFIN
				
				LEFT OUTER JOIN E043MPC
				    ON E070EMP.CODMPF = E043MPC.CODMPC
				
				LEFT OUTER JOIN E043PCM
				    ON E501RAT.CTAFIN = E043PCM.CTARED
				   AND E043PCM.CODMPC = '301'
				
				WHERE 1 = 1
				  AND E501TCP.SITTIT NOT IN ('LS','CA')
				  AND E501TCP.CODFOR NOT IN ('11143','21982','17661','46501','5517','48831','17935','2394','7868')
				  AND E501TCP.CODTPT NOT IN ('ADT','FDE','SDE')
				  AND E501TCP.VCTPRO >= TO_DATE('2025-01-01','YYYY-MM-DD')
				   ", HierarchicalNavigation = true])
				in
				  Fonte
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

