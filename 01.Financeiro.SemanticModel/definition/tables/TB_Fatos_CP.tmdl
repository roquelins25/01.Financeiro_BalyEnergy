	partition TB_Fatos_CP = m
		mode: import
		queryGroup: _Fatos\CP_CR
		source =
				let
				  Fonte = Sql.Database("159.112.182.77", "I260220090255_ERPP", [Query="select    #(lf)E501TCP.CodEmp,            #(lf)E070EMP.NomEmp, #(lf)CASE#(lf)    WHEN E095FOR.CodFor IN (36223, 40797, 2491)#(lf)        THEN CONVERT(VARCHAR(20), E095FOR.CodFor)#(lf)    ELSE E501TCP.CodTpt#(lf)END AS Tipo,#(lf)E095FOR.CodFor,   #(lf)E095FOR.NomFor,   #(lf)E501TCP.NumTit, #(lf)E044CCU.CodCcu,   #(lf)E044CCU.DesCcu,   #(lf)E091PLF.CtaFin,   #(lf)E091PLF.DesCta,   #(lf)E501TCP.datemi,#(lf)E501TCP.datent,#(lf)E501TCP.VCTPRO,  #(lf)case#(lf)#(tab)when E091PLF.CtaFin is null then (E501TCP.vlrabe * -1)#(lf)#(tab)when E091PLF.CtaFin is not null then (E501RAT.VlrRat * -1)       #(lf)end as vlrabe, #(lf)E043PCM.despar#(lf)from sapiens_producao.E501TCP #(lf)left outer join sapiens_producao.E501RAT on E501RAT.CodEmp = E501TCP.CodEmp  #(lf)                                        and E501RAT.CodFil = E501TCP.CodFil #(lf)                                        and E501RAT.NumTit = E501TCP.NumTit #(lf)                                        and E501RAT.CodTpt = E501TCP.CodTpt#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)and E501RAT.CodFor = E501TCP.CodFor #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)and E501RAT.SomSub = 1#(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E070EMP on E501TCP.CodEmp = E070EMP.CodEmp#(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E095FOR on E501TCP.CodFor = E095FOR.CodFor#(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E044CCU on E501RAT.CodEmp = E044CCU.CodEmp #(lf)                                        and E501RAT.CodCcu = E044CCU.CodCcu #(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E091PLF on E501RAT.CodEmp = E091PLF.CodEmp#(lf)                                        and E501RAT.CtaFin = E091PLF.CtaFin #(lf)#(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E043MPC on E070EMP.CodMpf = E043MPC.CodMpc#(lf)#(lf)/**/#(lf)LEFT OUTER join sapiens_producao.E043PCM on E043MPC.CodMpc = E043PCM.CodMpc#(lf)                                        and E501RAT.CtaFin = E043PCM.CtaRed #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)and E043PCM.CodMpc = '301'   #(lf)#(lf)where 1 = 1            #(lf)and E501TCP.SitTit NOT IN ('LS','CA') #(lf)AND E501TCP.VLRABE > 0 #(lf)And E501TCP.codfor NOT IN ('11143','21982','17661','46501','5517','48831','17935','2394','7868')#(lf)AND E501TCP.CODTPT  NOT IN ('ADT','FDE','SDE')#(lf)and E501TCP.VCTPRO >= '20240101'", CommandTimeout=#duration(0, 2, 0, 0)])
				in
				  Fonte

