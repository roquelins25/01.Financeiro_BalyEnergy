		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"TB_Fatos_CP","TableItemName":"ID_AGP","ObjectType":4},"LinkType":"UsedInGroup"}]

	column ID_AGP =
			SWITCH(
				TRUE,
				ISBLANK('TB_Fatos_CP'[DESPAR]),
				"(Em branco)",
				'TB_Fatos_CP'[DESPAR] IN {"Despesas Administrativas"},
				"1001",
				'TB_Fatos_CP'[DESPAR] IN {"Despesas com Pessoal"},
				"1002",
				'TB_Fatos_CP'[DESPAR] IN {"Despesas com Produtos"},
				"1003",
				'TB_Fatos_CP'[DESPAR] IN {"Despesas com Veículos"},
				"1004",
