	partition 'CALENDARIO DAX' = calculated
		mode: import
		source =
				
				var minAno = YEAR(MIN(TB_Fatos[emissao]))
				var MaxAno = YEAR(MAX(TB_Fatos[vencimento]))
				return
				ADDCOLUMNS(
				    FILTER(
				        CALENDARAUTO(),
				        YEAR([Date]) >= minAno &&
				        YEAR([Date]) <= MaxAno),
				        "Ano", YEAR([Date]),
				        "Mês", MONTH([Date]),
				        "Nome do Mês", FORMAT([Date],"mmmm","PT-BR"),
				        "Mês Abrev",FORMAT([Date],"mmm"),
				        "trimestre", QUARTER([Date]),
				        "Semestre", IF(MONTH([Date]) <= 6, "1º Semestre", "2º Semestre"),
				        "Dia",DAY([Date]),
				        "DiasSemana",SWITCH(
				            WEEKDAY([Date]),
				            1,"Domingo",
				            2,"Segunda",
				            3,"Terça",
				            4,"Quarta",
				            5,"Quinta",
				            6,"Sexta",
				            7,"Sabado"),
				        "Ano-Mes",FORMAT([Date],"mmm","PT-BR")&"-"&RIGHT(YEAR([Date]),2),
				        "AnoMesOrdem", YEAR( [Date] )*100 + MONTH([Date]),
				        "MesAtual", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), "S", "N" ),
				        "AnoTEXT", FORMAT( YEAR( [Date] ), "" ),
				        "Vencidos?", IF( [Date] < TODAY(), "Vencidas", "A Vencer" )
				        )

	annotation PBI_Id = 70c714a6d9dd46e697057a3dbd334d70

