	partition TB_Verbas = m
		mode: import
		queryGroup: _Fatos
		source =
				let
				  Origem = Sql.Database("159.112.182.77", "I260220090255_ERPP", [CommandTimeout=#duration(0, 2, 0, 0), Query="#(tab)select #(lf)#(tab)'Competencia' as Tipo,#(lf)#(tab)    format(cp.datEnt,'MM/yyyy') AS Data_BI,#(lf)#(tab)    cp.numtit,#(lf)#(tab)    cp.codtpt,#(lf)#(tab)    cp.codfor,#(lf)#(tab)    CONVERT(date, cp.datger, 103) AS datger,#(lf)#(tab)    CONVERT(date, cp.vctpro, 103) AS vctpro,#(lf)#(tab)    cp.vlrabe,#(lf)#(tab)    cp.sittit,#(lf)#(tab)    cp.codtns,#(lf)#(tab)    CASE #(lf)#(tab)        WHEN cp.datcmp IS NULL #(lf)#(tab)             OR YEAR(cp.datcmp) = 1900 #(lf)#(tab)        THEN NULL#(lf)#(tab)        ELSE CONVERT(date, cp.datcmp)#(lf)#(tab)    END AS usu_datalt,#(lf)#(tab)    cp.vlrori #(lf)#(tab)from e501tcp cp#(lf)#(tab)where cp.sittit NOT IN ('CA') AND #(lf)#(tab)#(tab)  cp.codtns IN('9051V') AND #(lf)#(tab)#(tab)  cp.datemi >= '20250101'#(lf)#(tab)"])
				in
				  Origem

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

