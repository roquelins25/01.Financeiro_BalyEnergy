	partition TB_Verbas = m
		mode: import
		queryGroup: _Fatos
		source = ```
				let
				  Origem = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				SELECT 
				    'Competencia'                                  AS TIPO,
				    TO_CHAR(CP.DATENT,'MM/YYYY')                   AS DATA_BI,
				    CP.NUMTIT,
				    CP.CODTPT,
				    CP.CODFOR,
				    TRUNC(CP.DATGER)                               AS DATGER,
				    TRUNC(CP.VCTPRO)                                AS VCTPRO,
				    CP.VLRABE,
				    CP.SITTIT,
				    CP.CODTNS,
				    CASE 
				        WHEN CP.DATCMP IS NULL 
				             OR EXTRACT(YEAR FROM CP.DATCMP) = 1900
				        THEN NULL
				        ELSE TRUNC(CP.DATCMP)
				    END                                             AS USU_DATALT,
				    CP.VLRORI
				
				FROM E501TCP CP
				
				WHERE CP.SITTIT NOT IN ('CA')
				  AND CP.CODTNS IN ('9051V')
				  AND CP.DATEMI >= TO_DATE('2025-01-01','YYYY-MM-DD')
				   ", HierarchicalNavigation = true])
				in
				  Origem
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

