	partition TB_Rede = m
		mode: import
		queryGroup: _Dim
		source = ```
				let
				  Fonte = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 2, 0, 0),
				   Query = "
				select
					e069gre.codgre,
					e069gre.nomgre,
					e069gre.siggre,
					e069hgr.vlrlim
				from e069gre 
				left join e069hgr 
					   on e069hgr.codgre = e069gre.codgre 
					  and e069hgr.codemp = 1
					  and e069hgr.codfil = 1
				   ", HierarchicalNavigation = true]),
				
				
				    Personalizar1 = Table.InsertRows(
				    Fonte,
				    0,
				    {
				        [
				            CODGRE = 0,
				            NOMGRE = "Sem Rede",
				            SIGGRE = "Sem Rede",
				            VLRLIM = 0
				        ]
				    }
				)
				in
				  Personalizar1
				```

