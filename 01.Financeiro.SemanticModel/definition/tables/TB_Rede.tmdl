	partition TB_Rede = m
		mode: import
		queryGroup: _Dim
		source = ```
				let
				  Fonte = Sql.Database("159.112.182.77", "I260220090255_ERPP", [Query="
				select
					e069gre.codgre,
					e069gre.nomgre,
					e069gre.siggre,
					e069hgr.vlrlim
				from e069gre 
				left join e069hgr 
					   on e069hgr.codgre = e069gre.codgre 
					  and e069hgr.codemp = 1
					  and e069hgr.codfil = 1
				  
				  ", CommandTimeout=#duration(0, 2, 0, 0)]),
				    Personalizar1 = Table.InsertRows(
				    Fonte,
				    0,
				    {
				        [
				            codgre = 0,
				            nomgre = "Sem Rede",
				            siggre = "Sem Rede",
				            vlrlim = 0
				        ]
				    }
				)
				in
				  Personalizar1
				```

