	partition TB_FRJ = m
		mode: import
		queryGroup: _Dim
		source = ```
				let
				  Origem = Oracle.Database("147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", [HierarchicalNavigation = true]),
				  
				  #"Navegação 1" = Origem{[Schema = "I260220090255_ERPP"]}[Data],
				  #"Navegação 2" = Table.Buffer(#"Navegação 1"{[Name = "E037FRJ"]}[Data]),
				
				    #"Outras Colunas Removidas" = Table.SelectColumns(#"Navegação 2",{"CODFRJ", "DESFRJ"}),
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Outras Colunas Removidas", "xTipo", each 
				        if [CODFRJ] = "910" then "Global" else 
				        if [CODFRJ] = "600" then "Verba" else
				        if [CODFRJ] = "980" then "Inadimplencia" else 
				        if [CODFRJ] = "JUR" then "Juridico" else
				        if [CODFRJ] = "500" then "Negociando" else
					      if [CODFRJ] = "700" then "Devolucao" else
				        if [CODFRJ] = "940" then "Não entregue" else
				        if [CODFRJ] = "SIN" then "Sinistro" else
				        if [CODFRJ] = "900" then "Resolução Interna" else
				        if [CODFRJ] = "400" then "Erro Digitacao" else
				        if [CODFRJ] = "300" then "Data Especifica" else
				        if [CODFRJ] = "800" then "Exportacao" else
				        if [CODFRJ] = "FUN" then "Funcionario" else
				        if [CODFRJ] = "100" then "Prorogacao Atraso na entrega" else
				        if [CODFRJ] = "CER" then "Cervejaria" 
				        else [DESFRJ]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna Condicional Adicionada",{{"xTipo", type text}}),
				    #"LinhaBlanck" = Table.InsertRows(#"Tipo Alterado", 0, {[CODFRJ = "00", DESFRJ = "Nao Classificado", xTipo = "Sem Classificacao"]} )
				in
				    #"LinhaBlanck"
				```

