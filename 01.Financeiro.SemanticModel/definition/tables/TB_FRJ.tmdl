	column 'xTipo (grupos)' =
			SWITCH(
				TRUE,
				ISBLANK('TB_FRJ'[xTipo]),
				"(Em branco)",
				'TB_FRJ'[xTipo] IN {"Data Especifica"},
				"Data Especifica",
				'TB_FRJ'[xTipo] IN {"Devolucao"},
				"Devolucao",
				'TB_FRJ'[xTipo] IN {"Não entregue"},
				"Entrega Pendente",
				'TB_FRJ'[xTipo] IN {"Inadimplencia"},
				"Inadimplencia",
				'TB_FRJ'[xTipo] IN {"Negociando"},
				"Negociando",
				'TB_FRJ'[xTipo] IN {"Prorogacao Atraso na entrega",
					"Prorrog. Erro Boleto / Subst.",
					"Prorrog. Fat. Antec. +7D",
					"Prorrog. Fluxo Pgto Cliente"},
				"Prorrogacao",
				'TB_FRJ'[xTipo] IN {"Sem Classificacao"},
				"Sem Classificacao",
				'TB_FRJ'[xTipo] IN {"Verba"},
				"Verba",
				"Demais Classif."
			)
