table TB_TIPO
	lineageTag: 25d321a0-b139-40ed-8663-c083a34eebf1

	column CODTPT
		dataType: string
		lineageTag: 939ed237-2556-4a64-acf6-454678d97375
		summarizeBy: none
		sourceColumn: CODTPT

		annotation SummarizationSetBy = Automatic

	column ID_AGP_TIPO_CP
		dataType: string
		lineageTag: 6bd3cfb0-51ce-47e3-962c-2e1aa72b4cc9
		summarizeBy: none
		sourceColumn: ID_AGP_TIPO_CP

		annotation SummarizationSetBy = Automatic

	column AGP_TIPO_CP
		dataType: string
		lineageTag: 688120d1-4be1-42dd-a393-6f3933a6ec9e
		summarizeBy: none
		sourceColumn: AGP_TIPO_CP
		sortByColumn: ID_AGP_TIPO_CP

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition TB_TIPO = m
		mode: import
		queryGroup: _Fatos
		source = ```
				let
				  Origem = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				WITH BASE AS (
				    SELECT
				        TPT.*,
				        CASE
				            WHEN CODTPT IN ('01','DEV','LFÉ','LIQ','LQP','PJD','RCO','DEJ','SEV','DPV','LRE') THEN '10001'
				            WHEN CODTPT IN ('INT','CCP','IRC','IRP','ISR','IRA') THEN '10002'
				            WHEN CODTPT IN ('ST4','ISS','DIF','FCP','MUL','IPV') THEN '10003'
				            WHEN CODTPT IN ('STP','PCI','PS3','PDA','DIV','PS2','PS1','PST','PMF') THEN '10004'
				            WHEN CODTPT IN ('EMP','LS3','FME','LEA','LS2','FIN') THEN '10005'
				            WHEN CODTPT IN ('INS','FGT','IRF','IRY','FGR') THEN '10006'
				            WHEN CODTPT LIKE 'V%' THEN '10007'
				            WHEN CODTPT IN ('ADT','LAD','CRE','DEC','FDE','SDE') THEN '10008'
				            ELSE '10009'
				        END AS ID_AGP_TIPO_CP
				    FROM E002TPT TPT
				)
				SELECT
				    CODTPT,
				    ID_AGP_TIPO_CP,
				    CASE ID_AGP_TIPO_CP
				        WHEN '10001' THEN 'PAGAMENTOS DIVERSOS'
				        WHEN '10002' THEN 'IMPOSTOS RETIDOS'
				        WHEN '10003' THEN 'IMPOSTOS S/ PARCELAMENTO'
				        WHEN '10004' THEN 'IMPOSTOS PARCELADOS'
				        WHEN '10005' THEN 'EMPRESTIMOS'
				        WHEN '10006' THEN 'IMPOSTOS FOLHA'
				        WHEN '10007' THEN 'VERBA'
				        WHEN '10008' THEN 'CRÉDITOS'
				        ELSE 'OUTROS'
				    END AS AGP_TIPO_CP
				FROM BASE
				   ", HierarchicalNavigation = true])
				in
				  Origem
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

