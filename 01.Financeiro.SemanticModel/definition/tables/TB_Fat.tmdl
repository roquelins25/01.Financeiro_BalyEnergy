	partition TB_Fat = m
		mode: import
		queryGroup: _Fatos
		source = ```
				let
				  Origem = Oracle.Database(
					"147.15.121.67:49182/I260220090255_p.subnetappxts2p.saaspremiumvcn1.oraclevcn.com", 
					[CommandTimeout = #duration(0, 0, 10, 0),
				   Query = "
				SELECT 
				    NFV.CODEMP                                     AS CODEMP,
				    NFV.CODFIL                                     AS CODFIL,
				    NFV.DATEMI                                     AS DATEMI,
				    NFV.CODSNF                                     AS CODSNF,
				    NFV.TIPNFS                                     AS TIPNFS,
				    IPV.TNSPRO                                     AS TNSPRO,
				    NFV.CODCLI                                     AS CODCLI,
				    NFV.CODREP                                     AS CODREP,
				    NFV.CODCPG                                     AS CODCPG,
				    NFV.CODFPG                                     AS CODFPG,
				    CPG.DESCPG                                     AS DESCPG,
				    CPG.PRZMED                                     AS PRZMED,
				    NFV.SITNFV                                     AS SITNFV,
				    NFV.NUMNFV                                     AS NUMNFV,
				
				    IPV.CODPRO                                     AS CODPRO,
				    IPV.VLRLIQ                                     AS VLRLIQ,
				    IPV.VLRFIN                                     AS VLRFIN,
				    IPV.QTDFAT                                     AS QTDFAT
				
				FROM E140NFV NFV
				
				INNER JOIN E140IPV IPV
				    ON NFV.CODEMP = IPV.CODEMP
				   AND NFV.CODFIL = IPV.CODFIL
				   AND NFV.CODSNF = IPV.CODSNF
				   AND NFV.NUMNFV = IPV.NUMNFV
				
				INNER JOIN E140IDE IDE
				    ON IDE.CODEMP = NFV.CODEMP
				   AND IDE.CODFIL = NFV.CODFIL
				   AND IDE.CODSNF = NFV.CODSNF
				   AND IDE.NUMNFV = NFV.NUMNFV
				
				LEFT JOIN E028CPG CPG
				    ON CPG.CODEMP = NFV.CODEMP
				   AND CPG.CODCPG = NFV.CODCPG
				
				WHERE IDE.SITDOE = 3  -- filtra retorno sefaz = Autorizada
				  AND NFV.SITNFV = 2  -- filtra somente NF fechada
				  AND (IPV.TNSPRO LIKE '5%' OR IPV.TNSPRO LIKE '6%' OR IPV.TNSPRO LIKE '7%')  -- Filtra Transacao de Venda
				  AND NFV.DATEMI >= TO_DATE('2026-01-01','YYYY-MM-DD')  
				  AND NFV.CODCLI NOT IN ('11143','21982','17661','5517','2394','17935') -- retira Fruts
				   ", HierarchicalNavigation = true])
				in
				  Origem
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

