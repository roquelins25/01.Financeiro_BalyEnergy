		                            -- Imposto sobre lucro
		                            { 5,2670 }, {5, 770 },
		
		                            -- Receitas / Despesas Financeiras
		                            { 6, 70 }, { 6, 420 },
		
		                            -- Fluxo Caixa de Investimentos
		                            {7,3880},{7,2100},{7,2760},{7,2150},{7,479},{7,450},{7,2080},{7,2140},{7,1020},{7,2680}
		                        }
		                    ),
		                    [xCOD] = xCOD
		                ),
		                "CtaFin", [CtaFin]
		            )
		```
