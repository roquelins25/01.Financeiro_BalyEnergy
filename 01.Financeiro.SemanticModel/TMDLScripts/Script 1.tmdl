createOrReplace

	ref table _Medidas

		measure '05. HTML SALDO DIA' = ```
				
				VAR vDataSelect = SELECTEDVALUE( 'CALENDARIO DAX'[Date] )
				
				-- ===== FATURAMENTO ===== (sem mudança)
				VAR vFaturamentoDiaAnterior = fxFORMAT( CALCULATE( [07. Total Faturado Geral], DATEADD('CALENDARIO DAX'[Date],-1,DAY) ), 4 )
				VAR vFaturamentoDoMes       = fxFORMAT( CALCULATE( [07. Total Faturado Geral], ALL('CALENDARIO DAX'[Dia]) ), 4 )
				VAR vFaturamentoDiaAnteriorBOLETO   = fxFORMAT( CALCULATE( [07. Total Faturado Geral], DATEADD('CALENDARIO DAX'[Date],-1,DAY), TB_PGT[abrfpg (grupos)]="Boleto" ), 4 )
				VAR vFaturamentoDiaAnteriorDEPOSITO = fxFORMAT( CALCULATE( [07. Total Faturado Geral], DATEADD('CALENDARIO DAX'[Date],-1,DAY), TB_PGT[abrfpg (grupos)]="Depósito" ), 4 )
				VAR vFaturamentoDiaAnteriorOUTROS   = fxFORMAT( CALCULATE( [07. Total Faturado Geral], DATEADD('CALENDARIO DAX'[Date],-1,DAY), TB_PGT[abrfpg (grupos)]="Outros" ), 4 )
				VAR vFaturamentoDoMesBOLETO   = fxFORMAT( CALCULATE( [07. Total Faturado Geral], ALL('CALENDARIO DAX'[Dia]), TB_PGT[abrfpg (grupos)]="Boleto" ), 4 )
				VAR vFaturamentoDoMesDEPOSITO = fxFORMAT( CALCULATE( [07. Total Faturado Geral], ALL('CALENDARIO DAX'[Dia]), TB_PGT[abrfpg (grupos)]="Depósito" ), 4 )
				VAR vFaturamentoDoMesOUTROS   = fxFORMAT( CALCULATE( [07. Total Faturado Geral], ALL('CALENDARIO DAX'[Dia]), TB_PGT[abrfpg (grupos)]="Outros" ), 4 )
				-- ===== TOTAIS por BANCOS e CONTAS ==========
				VAR tCorrente =CALCULATE([08. Saldo Bancos],RIGHT( TB_RTerceiros[xIDTerceiros], 2 ) = "01")
				VAR tGarantia =CALCULATE([08. Saldo Bancos],RIGHT( TB_RTerceiros[xIDTerceiros], 2 ) = "03")
				VAR tVinculada =CALCULATE([08. Saldo Bancos],RIGHT( TB_RTerceiros[xIDTerceiros], 2 ) = "02")
				VAR tTOTALGERAL = tCorrente + tGarantia + tVinculada
				
				-- ===== BANCOS e Contas =====
				VAR Bancos =SUMMARIZE(TB_RTerceiros,TB_RTerceiros[codBanco],TB_RTerceiros[Banco])
				
				VAR HTMLEntrada =
				
				CONCATENATEX(Bancos,
				    VAR BancoAtual = [codBanco]
				//---------------------------------------// Totais do banco//---------------------------------------
				    VAR Corrente =  CALCULATE([08. Saldo Bancos],TB_RTerceiros[xIDTerceiros] = BancoAtual & "_01")
				    VAR Garantia  = CALCULATE([08. Saldo Bancos],TB_RTerceiros[xIDTerceiros] = BancoAtual & "_03")
				    VAR Vinculada = CALCULATE([08. Saldo Bancos],TB_RTerceiros[xIDTerceiros] = BancoAtual & "_02")
				    VAR TOTAL = CALCULATE( [08. Saldo Bancos], ALL(TB_RTerceiros ), VALUES( 'CALENDARIO DAX'[Date])  )
				
				    VAR TOTAL_PERCENT = DIVIDE( ABS( Corrente + Garantia + Vinculada ), ABS( TOTAL ), 0 )
				//---------------------------------------
				// Contas do banco
				//---------------------------------------
				
				    VAR ContasBanco =
				    CONCATENATEX(
				        FILTER(
				            TB_RTerceiros,
				            TB_RTerceiros[codBanco] = BancoAtual
				        ),
				            VAR ContaAtual = TB_RTerceiros[xIDTerceiros]
				
				            VAR TipoConta = RIGHT( ContaAtual, 2 )
				
				            VAR SaldoConta =
				                CALCULATE(
				                    [08. Saldo Bancos],
				                      TB_RTerceiros[xIDTerceiros] = ContaAtual
				                ) 
				            VAR vTOTALCONTA = CALCULATE( [08. Saldo Bancos], REMOVEFILTERS(TB_RTerceiros[xIDTerceiros]), KEEPFILTERS(TB_RTerceiros[codBanco] = BancoAtual) )
				
				            VAR vPERCENT = DIVIDE( ABS( SaldoConta ), ABS( Corrente+Garantia+Vinculada ), 0 )
				            RETURN  
				
				            "<tr class='child-row Banco" & BancoAtual & "'>
				                <td class='indent2'>" & TB_RTerceiros[Contas] & "</td>
				                    <td class='num'>" & IF(TipoConta="01",fxFORMAT(SaldoConta,4),"") & "</td>
				                    <td class='num'>" & IF(TipoConta="03",fxFORMAT(SaldoConta,4),"") & "</td>
				                    <td class='num'>" & IF(TipoConta="02",fxFORMAT(SaldoConta,4),"") & "</td>
				                    <td class='num'>" & fxFORMAT(vTOTALCONTA,4) & "</td>
				                    <td class='pct'>" & fxFORMAT( vPERCENT, 5 ) &"</td>
				            </tr>", "" ,
				                DIVIDE( ABS([08. Saldo Bancos]), ABS(Corrente + Garantia + Vinculada), 0 ),
				            DESC
				        )
				            
				//---------------------------------------
				// Banco
				//---------------------------------------
				
				RETURN
				
				    "<tr class='child-row saldo toggle-row nested' data-target='Banco" & BancoAtual & "'>
				        <td class='indent'>" & [Banco] & "</td>
				            <td class='num'>" & fxFORMAT(Corrente,4) & "</td>
				            <td class='num'>" & fxFORMAT(Garantia,4) & "</td>
				            <td class='num'>" & fxFORMAT(Vinculada,4) & "</td>
				            <td class='num'>" & fxFORMAT(Corrente+Garantia+Vinculada,4) & "</td>
				            <td>"& fxFORMAT( TOTAL_PERCENT , 5 ) &"</td>
				    </tr>"
				    &
				    ContasBanco
				
				)
				
				-- ============================ SAIDAS ======================================
				
				VAR BaseCP =
				CALCULATETABLE(
				    TB_Fatos_CP,
				        REMOVEFILTERS( 'CALENDARIO DAX' ), 
				        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Ano] )), 
				        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Mês] ) )
				    )
				
				-- Empresas
				
				VAR Empresas =
				DATATABLE(
				    "Empresa", 
				    STRING,{
				        { "( + ) Grassi" },
				        { "Fruts Dia" },
				        { "Fruts Atrasada" },
				        { "Dubai" },
				        { "Girassol" }
				        })
				VAR vHTMLSAIDAS = 
				CONCATENATEX(
				    Empresas,
				    VAR EmpresaAtual = [Empresa]
				    VAR EmpresaID =
				        SWITCH(
				            EmpresaAtual,
				            "( + ) Grassi","grassi", 
				            "Fruts Dia","frutsdia", 
				            "Fruts Atrasada",
				            "frutsatrasada", 
				            "Dubai","dubai", 
				            "Girassol","girassol" )
				    VAR ProjetadoEmpresa = 0 
				    VAR AcumuladoEmpresa = 
				    SWITCH(
				        EmpresaID,
				            "Grassi", CALCULATE( [01. Valor AB CP], 
				                            REMOVEFILTERS( 'CALENDARIO DAX' ), 
				                            KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Ano] )), 
				                            KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Mês] ) )
				                            ),
				        0 )
				    VAR DiaEmpresa = 
				        SWITCH(
				        EmpresaID,
				            "Grassi",[01. Valor AB CP] ,
				        0 )
				    VAR TotalEmpresa = DiaEmpresa 
				    VAR PercentEmpresa = 0
				-------- LV1
				    VAR vTabelaAGP = 
				    ADDCOLUMNS(
				        SUMMARIZE( BaseCP,TB_Fatos_CP[ID_AGP],  TB_Fatos_CP[despar] ), 
				        "@Valor", CALCULATE( [01. Valor AB CP], 
				                        REMOVEFILTERS( 'CALENDARIO DAX' ), 
				                        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Ano] )), 
				                        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Mês] ) )
				                        ),
				        "@ValorDia", [01. Valor AB CP]
				                )
				    VAR AGPs = 
				    CONCATENATEX(
				        vTabelaAGP,
				        VAR AGPID = TB_Fatos_CP[ID_AGP]
				        VAR AGPAtual = TB_Fatos_CP[despar]
				        VAR ValorAGP = [@Valor]
				        VAR ValorDia = [@ValorDia]
				-------------------- LV2
				            VAR TabelaTipo =
				                ADDCOLUMNS(
				                    SUMMARIZE(
				                        FILTER(
				                            BaseCP,
				                            TB_Fatos_CP[ID_AGP] = AGPID
				                        ),
				                        TB_Fatos_CP[CtaFin],
				                        TB_Fatos_CP[DesCta]
				                    ),
				                    "@Valor", CALCULATE( [01. Valor AB CP], 
				                                REMOVEFILTERS( 'CALENDARIO DAX' ), 
				                                KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Ano] )), 
				                                KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Mês] ) )
				                                ),
				                    "@ValorDia", [01. Valor AB CP]
				                )
				
				            VAR Tipos =
				                CONCATENATEX(
				                    TabelaTipo,
				
				                    VAR TipoID = TB_Fatos_CP[CtaFin]
				                    VAR TipoAtual = TB_Fatos_CP[DesCta]
				                    VAR ValorTipo = [@Valor]
				                    VAR ValorDia = [@ValorDia]
				
				------------------------------- LV3
				                            VAR TabelaConta = 
				                            ADDCOLUMNS(
				                                SUMMARIZE(
				                                    FILTER(
				                                        BaseCP,
				                                        TB_Fatos_CP[ID_AGP] = AGPID && TB_Fatos_CP[CtaFin] = TipoID
				                                    ),
				                                    TB_CLI[codcli],
				                                    TB_CLI[nomcli] ),
				                            "@Valor", CALCULATE( [01. Valor AB CP], 
				                                        REMOVEFILTERS( 'CALENDARIO DAX' ), 
				                                        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Ano] )), 
				                                        KEEPFILTERS( VALUES( 'CALENDARIO DAX'[Mês] ) )
				                                        ),
				                            "@ValorDia", [01. Valor AB CP]
				                                     )
				                            
				                            VAR CONTAS = 
				                            CONCATENATEX(
				                                TabelaConta,
				                                    VAR ContaID = TB_CLI[codcli]
				                                    VAR ContaAtual = TB_CLI[nomcli]
				                                    VAR ValorConta = [@Valor]
				                                    VAR ValorDia = [@ValorDia]
				                                    
				                                    RETURN
				                                        "<tr class='child-row TIPO" & TipoID & "'>
				                                            <td class='indent3'>" & ContaAtual & "</td>
				                                            <td></td>
				                                            <td class='num'>" & fxFORMAT(ValorConta,4) & "</td>
				                                            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				                                            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				                                            <td></td>
				                                        </tr>",
				
				                                    "",
				                                    [@Valor],
				                                    ASC
				                                )
				------------------------------------------------------
				                    RETURN
				                        "<tr class='child-row AGP" & AGPID & " toggle-row nested'
				                            data-target = 'TIPO"& TipoID &"'>
				                            <td class='indent2'>" & TipoAtual & "</td>
				                            <td></td>
				                            <td class='num'>" & fxFORMAT(ValorTipo,4) & "</td>
				                            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				                            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				                            <td></td>
				                        </tr>"
				                        & CONTAS,
				                    "",
				                    [@Valor],
				                    ASC
				                )
				----------------------------------------
				        RETURN
				        "<tr class='child-row saldo toggle-row nested'
				            data-target='AGP" & AGPID & "'>
				            <td class='indent'>" & AGPAtual & "</td>
				            <td></td>
				            <td class='num'>" & fxFORMAT(ValorAGP,4) & "</td>
				            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				            <td class='num'>" & fxFORMAT(ValorDia,4) & "</td>
				            <td></td>
				        </tr>"
				        &
				        Tipos,
				        "", [@Valor], ASC )
				-------- SAIDA FINAL
				RETURN
				    "<tr class='bold child-row saldo  toggle-row nested'
				        data-target='" & EmpresaID & "'>
				        <td>" & EmpresaAtual & "</td>
				        <td></td>
				        <td class='num'>" & fxFORMAT(AcumuladoEmpresa,4) & "</td>
				        <td class='num'>" & fxFORMAT(DiaEmpresa,4) & "</td>
				        <td class='num'>" & fxFORMAT(TotalEmpresa,4) & "</td>
				        <td></td>
				    </tr>"
				&
				IF(
				    EmpresaID = "grassi",
				    AGPs,
				    ""
				) )
				-- ============================ Entradas TOTAIS ===================================
				VAR eCARTEIRA = [01. AB Simples]
				VAR eVinculada = [01. AB Vinculada]
				VAR eDescontada = [01. AB Descontada]
				
				VAR eEntradaTotal = ( eCARTEIRA + eVinculada + eDescontada )
				
				-- ========================== SAIDAS TOTAIS ======================================
				VAR eSaidas = ( [01. Valor AB CP] * -1 )
				VAR SALDO = tTOTALGERAL + eSaidas
				RETURN
				"<!DOCTYPE html>
				
				<html lang='pt-BR'>
				<head>
				<meta charset='UTF-8'>
				<title>Controle de Caixa</title>
				<style>
				  :root{
				    --azul:#1c3d6e; --azul-claro:#e8eef7; --verde:#e9f7ee;
				    --amarelo:#fff200; --borda:#c9d2df; --vermelho:#b02a2a;
				  }
				  *{box-sizing:border-box;}
				  body{font-family:'Segoe UI', Arial, sans-serif; background:#f4f6f9; padding:24px; color:#1a1a1a; font-size:14px;}
				  .sheet{max-width:900px; margin:0 auto; background:#fff; border:1px solid var(--borda); box-shadow:0 2px 8px rgba(0,0,0,.06);}
				  table{width:100%; border-collapse:collapse;}
				  td, th{padding:6px 10px; border:1px solid var(--borda); white-space:nowrap;}
				  .dia-row td{font-weight:700; font-size:15px;}
				  .header-row th{background:var(--azul); color:#fff; text-align:left; font-weight:600;}
				  .section-title{background:var(--azul-claro); font-weight:700; font-size:15px; color:var(--azul); padding-top:14px;}
				  .bold{font-weight:700;}
				  .num{text-align:right;}
				  .pct{text-align:right; color:#555;}
				  .indent{padding-left:28px !important;}
				  .indent2{padding-left:56px !important;}
				  .indent3{padding-left:76px !important;}
				  .negativo{color:var(--vermelho);}
				  .saldo-dia td{background:var(--amarelo); font-weight:800; font-size:15px;}
				  .toggle-row{cursor:pointer; background:#fafbfd; user-select:none;}
				  .toggle-row:hover{background:#eef2f8;}
				  .toggle-row td:first-child::before{content:'▸'; display:inline-block; margin-right:6px; transition:transform .15s ease; color:var(--azul); font-size:11px;}
				  .toggle-row.open td:first-child::before{transform:rotate(90deg);}
				  .child-row.saldo { display: table-row; }
				  .child-row:not(.saldo) { display: none;}
				  .child-row.show{display:table-row;}
				  .total-strong td{background:var(--azul-claro); font-weight:700;}
				</style>
				</head>
				<body>
				<div class='sheet'>
				<table>
				
				  <tr><td class='bold'>DIA</td><td colspan='2' class='bold'>"& vDataSelect &"</td><td colspan='3'></td></tr>
				  <tr><td colspan='6' style='border:none;padding:4px;'></td></tr>
				
				  <tr class='header-row'><th>Vendas</th><th>Boleto</th><th>Depósito</th><th>Outros</th><th>Total</th><th>%</th></tr>
				  <tr>
				    <td class='bold'>Vendas dia Anterior</td>
				    <td class='num bold'>"& vFaturamentoDiaAnteriorBOLETO &"</td>
				    <td class='num bold'>"& vFaturamentoDiaAnteriorDEPOSITO &"</td>
				    <td class='num bold'>"& vFaturamentoDiaAnteriorOUTROS &"</td>
				    <td class='num bold'>"& vFaturamentoDiaAnterior &"</td>
				    <td></td>
				  </tr>
				  <tr>
				    <td>Vendas Acumuladas Mês</td>
				    <td class='num'>"& vFaturamentoDoMesBOLETO &"</td>
				    <td class='num'>"& vFaturamentoDoMesDEPOSITO &"</td>
				    <td class='num'>"& vFaturamentoDoMesOUTROS &"</td>
				    <td class='num'>"& vFaturamentoDoMes &"</td>
				    <td></td>
				  </tr>
				
				  <tr><td colspan='6' style='border:none;padding:6px;'></td></tr>
				  <tr><td class='section-title'>Valor de Título para troca</td><td class='num bold'>"& vFaturamentoDiaAnteriorBOLETO &"</td></tr>
				  <tr><td colspan='6' style='border:none;padding:6px;'></td></tr>
				
				    <!-- Saldo Conta -->
				
				  <tr class='header-row'><th>Saldo em conta</th><th>Corrente</th><th>Garantia</th><th>Vinculada</th><th>Total</th><th>%</th></tr>
				  <tr class='total-strong'>
				    <td>Total</td>
				    <td class='num'>"& fxFORMAT(tCorrente,4) & "</td>
				    <td class='num'>"& fxFORMAT(tGarantia,4) & "</td>
				    <td class='num'>"& fxFORMAT(tVinculada,4) & "</td>
				    <td class='num'>"& fxFORMAT(tTOTALGERAL,4) &"</td>
				    <td class='pct'></td>
				  </tr>
				    "& HTMLEntrada &"
				
				  <tr><td colspan='6' style='border:none;padding:6px;'></td></tr>
				
				<!-- Entradas -->
				
				  <tr class='header-row'>
				    <th>Entradas</th><th>Carteira</th><th>Vinculada</th><th>Antecipada/Descontada</th><th>Total</th><th>%</th>
				  </tr>
				     <td class='bold'>Projeçao de Contas a Receber</td>
				        <td class='num bold'>"& fxFORMAT(eCARTEIRA,4) & "</td>
				        <td class='num bold'>"& fxFORMAT(eVinculada,4) & "</td>
				        <td class='num bold'>"& fxFORMAT(eDescontada,4) & "</td>
				        <td class='num bold'>"& fxFORMAT(eEntradaTotal,4) & "</td>
				        <td class='pct'></td>
				  </tr>
				  <tr><td colspan='6' style='border:none;padding:6px;'></td></tr>
				
				<!-- Saidas -->
				
				  <tr class='bold header-row'><th>Saídas</th><th>Projetado</th><th>Acumulado Mês</th><th>Dia</th><th>Total</th><th>%</th></tr>
				  <tr class='bold toggle-row total-strong' data-target='grassi'>
				    " & vHTMLSAIDAS & "
				
				  <tr class='saldo-dia'><td>Saldo dia</td><td></td><td></td><td></td><td class='num negativo'>"& fxFORMAT(SALDO,4) & "</td><td></td></tr>
				</table>
				</div>
				
				<script>
				document.querySelectorAll('.toggle-row').forEach(row=>{
				  row.addEventListener('click',()=>{
				    const target = row.dataset.target;
				    row.classList.toggle('open');
				    document.querySelectorAll('.'+target).forEach(r=>r.classList.toggle('show'));
				  });
				});
				</script>
				
				</body>
				</html>"
				```
			displayFolder: 05. HTML
			lineageTag: 6b11a18f-3abe-4743-a506-549e7c85aff0

