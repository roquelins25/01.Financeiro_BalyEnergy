		column 'CALENDARIO DAX_AnoMesOrdem'
			formatString: 0
			lineageTag: 428b011e-2465-43fd-9258-478898865878
			summarizeBy: sum
			isNameInferred
			sourceColumn: CALENDARIO DAX[AnoMesOrdem]

