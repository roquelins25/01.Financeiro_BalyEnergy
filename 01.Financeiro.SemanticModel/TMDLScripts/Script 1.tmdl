		partition xCalendarioTable = calculated
			mode: import
			source = ```
					
					VAR _MES = 
					ADDCOLUMNS(
					    DISTINCT(
					    SELECTCOLUMNS(
					        'CALENDARIO DAX',
					        'CALENDARIO DAX'[Ano-Mes],
					        'CALENDARIO DAX'[Mês Abrev],
					        'CALENDARIO DAX'[AnoMesOrdem] ) ),
					    "Periodo", 'CALENDARIO DAX'[Ano-Mes] ,
					    "Cod. Periodo", 1 )
					
					VAR _OrcadoMes = 
					ROW(
					    "Ano-Mes", BLANK(),
					    "Mês Abrev", BLANK(),
					    "Mês", 999998 ,
					    "Periodo", "Orçado Mês",
					    "Cod. Periodo", 2 )
					
					VAR _DifMes = 
					ROW(
					    "Ano-Mes", BLANK(),
					    "Mês Abrev", BLANK(),
					    "Mês", 999999 ,
					    "Periodo", "Dif. Mês",
					    "Cod. Periodo", 3 )
					
					VAR _OrcadoAno = 
					ROW(
					    "Ano-Mes", BLANK(),
					    "Mês Abrev", BLANK(),
					    "Mês", 9999999 ,
					    "Periodo", "Orçado Ano",
					    "Cod. Periodo", 4 )
					
					VAR _ANO = 
					ADDCOLUMNS(
					    DISTINCT(
					    SELECTCOLUMNS(
					        'CALENDARIO DAX',
					        'CALENDARIO DAX'[Ano] ) ),
					    "Mês Abrev", BLANK(),
					    "Mês", 99999999 ,
					    "Periodo", CONCATENATE("Real Ano ", 'CALENDARIO DAX'[Ano] ),
					    "Cod. Periodo", 5 )
					
					VAR _DifAno = 
					ROW(
					    "Ano-Mes", BLANK(),
					    "Mês Abrev", BLANK(),
					    "Mês", 999999999 ,
					    "Periodo", "Dif. Ano",
					    "Cod. Periodo", 6 )
					RETURN
					UNION(_MES,_OrcadoMes,_DifMes,_OrcadoAno,_ANO,_DifAno )
					
					```

		annotation PBI_Id = 2cbb8927136348aa9806b6ff860b352a

